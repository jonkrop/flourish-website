  {/* Breathe-along pacer: runs the chosen pattern (in, hold, out, hold seconds) until stopped. */}
  <script is:inline>
    (function(){
      var root=document.getElementById('pacer');if(!root)return;
      var orb=root.querySelector('.orb'),word=root.querySelector('.orb-w'),num=root.querySelector('.orb-n');
      var go=root.querySelector('.pacer-go'),picks=root.querySelectorAll('.pacer-pick button');
      var still=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var pattern=[5,0,5,0],timer=null,running=false;
      var PHASES=[['Breathe in',1],['Hold',1],['Breathe out',0],['Hold',0]];
      function size(big,secs){
        orb.style.transitionDuration=still?'0s':secs+'s';
        orb.style.transform='scale('+(big?1:.5)+')';
      }
      function stop(){
        clearTimeout(timer);running=false;go.textContent='Start';
        word.textContent='Ready';num.textContent='';size(false,.6);
      }
      function phase(i){
        if(!running)return;
        var secs=pattern[i];
        if(!secs){phase((i+1)%4);return;}
        word.textContent=PHASES[i][0];size(PHASES[i][1]===1,secs);
        var left=secs;num.textContent=left;
        (function tick(){
          timer=setTimeout(function(){
            if(!running)return;
            left--;
            if(left>0){num.textContent=left;tick();}else{phase((i+1)%4);}
          },1000);
        })();
      }
      go.addEventListener('click',function(){
        if(running){stop();return;}
        running=true;go.textContent='Stop';phase(0);
      });
      [].forEach.call(picks,function(b){
        b.addEventListener('click',function(){
          [].forEach.call(picks,function(o){o.setAttribute('aria-pressed',o===b?'true':'false');});
          pattern=b.getAttribute('data-p').split(',').map(Number);
          if(running){clearTimeout(timer);phase(0);}
        });
      });
    })();
  </script>

  {/* Jump links into a closed toggle (contents links, shared #anchors, back/forward) open it first. */}
  <script is:inline>
    (function(){
      function target(hash){
        if(!hash||hash.length<2)return null;
        try{return document.getElementById(decodeURIComponent(hash.slice(1)));}catch(e){return null;}
      }
      function openAround(el){
        var opened=false,d=el&&el.closest('details');
        while(d){if(!d.open){d.open=true;opened=true;}d=d.parentElement&&d.parentElement.closest('details');}
        return opened;
      }
      // Before the browser follows an in-page link, so it scrolls to the opened content.
      document.addEventListener('click',function(e){
        var a=e.target.closest&&e.target.closest('a[href^="#"]');
        if(a)openAround(target(a.getAttribute('href')));
      },true);
      function sync(){var el=target(location.hash);if(openAround(el))el.scrollIntoView();}
      window.addEventListener('hashchange',sync);
      sync();
      window.addEventListener('beforeprint',function(){[].forEach.call(document.querySelectorAll('details.fold'),function(d){d.open=true;});});
    })();
  </script>
