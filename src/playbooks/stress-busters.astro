  {/* Jump links into a closed toggle (contents links, shared #anchors, back/forward) open it first. */}
  <script is:inline>
    (function(){
      function target(hash){
        if(!hash||hash.length<2)return null;
        try{return document.getElementById(decodeURIComponent(hash.slice(1)));}catch(e){return null;}
      }
      function openAround(el){
        var opened=false,d=el&&el.closest('details');
        while(d){if(!d.open){d.open=true;opened=true;}d=d.parentElement&&d.parentElement.closest('details');}
        return opened;
      }
      // Before the browser follows an in-page link, so it scrolls to the opened content.
      document.addEventListener('click',function(e){
        var a=e.target.closest&&e.target.closest('a[href^="#"]');
        if(a)openAround(target(a.getAttribute('href')));
      },true);
      function sync(){var el=target(location.hash);if(openAround(el))el.scrollIntoView();}
      window.addEventListener('hashchange',sync);
      sync();
      window.addEventListener('beforeprint',function(){[].forEach.call(document.querySelectorAll('details.fold'),function(d){d.open=true;});});
    })();
  </script>
