---
// Web-native playbook: 30-Second Stress Busters and Mood Boosters (presenter: Jon).
// Process: ../../../playbook-guide.md. Renders inside PlaybookLayout via the topic page.
// A reference, not a recap: the six Flourish cheat sheets are the backbone (structure and wording),
// checked against Jon's 2026-10-05 delivery (Wispr transcript; client not named here) for what was taught.
// Gratitude and Generosity have no cheat sheet: same shape, from the delivery.
// Copy is Jon's wording; check jon-voice.md before changing it.
// Orange/peach is reserved for the exact words to say (out loud or in your head).
import PlaybookLayout from '../layouts/PlaybookLayout.astro';

const { entry, clientLookup = {} } = Astro.props;
const title = entry.data.title;

const CHAPTERS = [
  { id: 'reframe', n: '1', short: 'Reframe' },
  { id: 'breathe', n: '2', short: 'Breathe' },
  { id: 'sure', n: '3', short: 'Am I sure?' },
  { id: 'gratitude', n: '4', short: 'Gratitude' },
  { id: 'generosity', n: '5', short: 'Generosity' },
  { id: 'goodwill', n: '6', short: 'Goodwill' },
  { id: 'more', n: '+', short: 'More tools' },
];

const BUSTERS = [
  { id: 'reframe', n: '1', t: 'Reframe anxiety as excitement' },
  { id: 'breathe', n: '2', t: 'Paced breathing' },
  { id: 'sure', n: '3', t: '“Am I sure that’s true?”' },
];
const BOOSTERS = [
  { id: 'gratitude', n: '4', t: 'Gratitude' },
  { id: 'generosity', n: '5', t: 'Generosity' },
  { id: 'goodwill', n: '6', t: 'Goodwill' },
];

// Outside resources stay downloadable (they're not ours).
const READING = [
  { name: 'Gratitude White Paper (UC Berkeley Greater Good Science Center)', url: '/uploads/Gratitude-White-Paper.pdf' },
  { name: 'Counting Blessings vs. Burdens (Emmons & McCullough)', url: '/uploads/Counting-Blessings-vs-Burdens.pdf' },
  { name: 'Positive Psychology Progress (Seligman et al.)', url: '/uploads/Positive-Psychology-Progress-Seligman.pdf' },
  { name: 'Martin Seligman on Lawyer Happiness', url: '/uploads/Seligman-Lawyer-Happiness.pdf' },
  { name: 'Breath of Life (Gerritsen & Band)', url: '/uploads/Breath-of-Life-Gerritsen-Band.pdf' },
  { name: 'Buddhist-Derived Loving-Kindness and Compassion Meditation (Shonin et al.)', url: '/uploads/Loving-Kindness-Meditation-Shonin.pdf' },
  { name: 'Effect of Kindness-Based Meditation on Health and Well-Being: Systematic Review and Meta-Analysis', url: '/uploads/Kindness-Based-Meditation-Meta-Analysis.pdf' },
  { name: 'Well-Being Toolkit for Lawyers and Legal Employers', url: '/uploads/Well-Being-Toolkit.pdf' },
];

const PHRASES = ['May you be happy.', 'May you be healthy.', 'May you be safe.', 'May you be at peace.'];
---
<PlaybookLayout
  title={title}
  description="Three 30-second methods for stress and anxiety, and three for getting more of the good stuff, from the Flourish workshop with Jon Krop."
  chapters={CHAPTERS}
  clientLookup={clientLookup}
>
  {/* ============ Hero ============ */}
  <section class="hero" id="top">
    <div class="wide hero-in">
      <div>
        <img class="logo" src="/images/logo-orange.png" alt="Flourish Legal Well-Being" width="168" />
        <div class="backlink" id="backlink"><a></a></div>
        <h1>30-Second Stress Busters and Mood Boosters</h1>
        <p class="sub-title">Three ways to deal with the difficult stuff, and three ways to get more of the good stuff</p>
        <p class="from">A playbook from the workshop, with Jon Krop of <a href="https://teamflourish.com">Flourish</a></p>
      </div>
      <figure class="dial" aria-label="Short moments, many times">
        <div class="dial-ring">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <circle class="dial-track" cx="100" cy="100" r="88" />
            <circle class="dial-dash" cx="100" cy="100" r="88" pathLength="60" />
          </svg>
          <div class="dial-mid"><span class="dial-n">30</span><span class="dial-u">seconds</span></div>
        </div>
        <figcaption>
          <span class="dial-q">“Short moments, many times.”</span>
          <span class="dial-src">Advice my Tibetan meditation teachers gave all the time</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <main>
  {/* ============ Intro + contents ============ */}
  <section class="intro">
    <div class="wide">
      <p class="big">Taking care of yourself doesn’t always need to be time-intensive. Each of these six methods is doable in as little as 30 seconds, if that’s all the time you’ve got.</p>
    </div>
  </section>

  <nav class="contents" aria-label="The six methods">
    <div class="wide">
      <div class="groups">
        <div>
          <h2 class="grp">30-second stress busters</h2>
          <ol class="cards3">
            {BUSTERS.map((c) => (
              <li><a href={`#${c.id}`}><span class="n">{c.n}</span><span class="t">{c.t}</span></a></li>
            ))}
          </ol>
        </div>
        <div>
          <h2 class="grp">30-second mood boosters</h2>
          <ol class="cards3">
            {BOOSTERS.map((c) => (
              <li><a href={`#${c.id}`}><span class="n">{c.n}</span><span class="t">{c.t}</span></a></li>
            ))}
          </ol>
        </div>
      </div>
      <div class="also-row">
      <p class="also">Plus two more tools, <a href="#tool-noting">deconstructing anxiety</a> and <a href="#tool-sleep">getting to sleep</a>, and some <a href="#reading">further reading</a>.</p>
      <p class="legend"><span class="chip" aria-hidden="true"></span>Lines in orange boxes like this are the exact words to say, out loud or in your head.</p>
      </div>
    </div>
  </nav>

  {/* ============ 1: Cognitive reframing (cheat sheet: Cognitive Reframing) ============ */}
  <section class="principle alt" id="reframe">
    <div class="col">
      <header class="ph"><span class="num" aria-hidden="true">1</span><h2>Reframe anxiety as excitement</h2></header>
      <p class="lead">One simple, powerful way to manage anxiety is to reinterpret it as a more positive emotion: excitement.</p>
      <p class="body">This works because anxiety and excitement are physiologically similar: both are “high arousal” states. Anxiety and calm are basically opposites.</p>
    </div>
    <div class="wide" style="max-width:calc(940px + 2*var(--gutter))">
      <div class="arousal" role="group" aria-label="Calm, anxiety and excitement compared">
        <div class="st calm">
          <b>Calm</b>
          <span class="lvl">Low arousal</span>
          <p>Muscles relaxed. Heart rate slow. Breathing slow.</p>
        </div>
        <div class="hop far"><span class="ar" aria-hidden="true"></span><span>An enormous U-turn</span></div>
        <div class="st anx">
          <b>Anxiety</b>
          <span class="lvl">High arousal</span>
          <p>Muscles tense. Heart rate and breathing accelerated. Adrenaline and cortisol flooding your bloodstream.</p>
        </div>
        <div class="hop near"><span class="ar" aria-hidden="true"></span><span>Much closer</span></div>
        <div class="st exc">
          <b>Excitement</b>
          <span class="lvl">High arousal</span>
          <p>High levels of adrenaline. Elevated heart rate. Accelerated breathing.</p>
        </div>
      </div>
    </div>
    <div class="col">
      <p class="body" style="margin-top:32px">Research shows that when people reframe anxiety as excitement, they perform better at anxiety-provoking tasks, feel more excited, and tend to see issues as opportunities rather than as threats.</p>
      <p class="body">This can be as simple as saying the words, out loud or in your head, when you’re facing an anxiety-provoking situation:</p>
      <p class="borrow-line">“I’m excited.”</p>
    </div>
  </section>

  {/* ============ 2: Paced breathing (cheat sheet: Calming the Nervous System) ============ */}
  <section class="principle" id="breathe">
    <div class="col">
      <header class="ph"><span class="num" aria-hidden="true">2</span><h2>Paced breathing</h2></header>
      <p class="lead">This simple breathing exercise can reduce stress and anxiety, sometimes within minutes. It’s discreet: no one will know you’re doing it.</p>
      <p class="body">Research suggests that it works by stimulating a cranial nerve called the vagus nerve, which activates the parasympathetic nervous system and calms the fight-or-flight response.</p>
      <div class="core2">
        <div class="core">
          <h3>Breathe from the belly</h3>
          <p>Expand your lower abdomen, not just your chest, as you breathe. To ensure you’re doing this, rest a hand on your stomach.</p>
        </div>
        <div class="core">
          <h3>Breathe slowly</h3>
          <p>Research indicates that around six breaths per minute is an effective rate. On average, people take 10 to 14.</p>
          <div class="rate" aria-hidden="true">
            <div class="rate-row"><span class="dots">{Array.from({ length: 14 }, (_, i) => <i class={i >= 10 ? 'maybe' : ''}></i>)}</span><span class="rl">10 to 14 a minute</span></div>
            <div class="rate-row slow"><span class="dots">{Array.from({ length: 6 }, () => <i></i>)}</span><span class="rl">about 6</span></div>
          </div>
        </div>
      </div>
      <h3 class="sub">Three patterns to try</h3>
      <p class="body">Count in seconds. Try each and see which one feels most relaxing for you, because that’s a personal thing.</p>
    </div>
    <div class="wide" style="max-width:calc(820px + 2*var(--gutter))">
      <div class="patterns">
        <div class="pat">
          <div class="pat-h"><b>Equal segments</b><span>5 in, 5 out</span></div>
          <div class="cells" aria-hidden="true">
            <span class="seg in"><em>In</em>{Array.from({ length: 5 }, () => <i></i>)}</span>
            <span class="seg out"><em>Out</em>{Array.from({ length: 5 }, () => <i></i>)}</span>
          </div>
          <p class="pat-n">Inhale and exhale the same length.</p>
        </div>
        <div class="pat">
          <div class="pat-h"><b>Lengthened exhale</b><span>4 in, 7 out</span></div>
          <div class="cells" aria-hidden="true">
            <span class="seg in"><em>In</em>{Array.from({ length: 4 }, () => <i></i>)}</span>
            <span class="seg out"><em>Out</em>{Array.from({ length: 7 }, () => <i></i>)}</span>
          </div>
          <p class="pat-n">Many people (not everyone) find a longer exhale deepens the calming effect. Lengthen it, but not to a degree that feels uncomfortable.</p>
        </div>
        <div class="pat boxpat">
          <div class="pat-h"><b>Box breathing</b><span>4 in, 4 hold, 4 out, 4 hold</span></div>
          <div class="box" aria-hidden="true">
            <span class="side t">Inhale 4</span>
            <span class="side r">Hold 4</span>
            <span class="side b">Exhale 4</span>
            <span class="side l">Hold 4</span>
          </div>
          <p class="pat-n">All four segments are the same length, like the four sides of a box.</p>
        </div>
      </div>
    </div>
    <div class="col">
      <p class="body" style="margin-top:24px">Once you have the basics, you can add a short, comfortable pause between the inhale and exhale, or bring some attention to the bodily sensations of breathing, at either the nostrils or the abdomen.</p>
    </div>
  </section>

  {/* ============ 3: Am I sure that's true? (cheat sheet: Seeing Through Negative Thoughts) ============ */}
  <section class="principle alt" id="sure">
    <div class="col">
      <header class="ph"><span class="num" aria-hidden="true">3</span><h2>“Am I sure that’s true?”</h2></header>
      <p class="lead">We have a tendency to take our thoughts as true. In fact, they’re often distorted or simply false.</p>
      <p class="body">When a negative thought is troubling you, ask yourself:</p>
      <p class="borrow-line">“Am I sure that’s true?”</p>
      <p class="body">Merely asking is often enough to loosen the thought’s hold, because it punctures the reflexive belief that our thoughts are always telling us the truth.</p>
    </div>

    <div class="wide" style="max-width:calc(940px + 2*var(--gutter))">
      <div class="story">
        <div class="story-txt">
          <h3>“Come to my office now.”</h3>
          <p>When I was a junior associate, my phone buzzed one morning with an email from a partner on a case I was working on. It just said, “Come to my office now.”</p>
          <p>I managed to pack quite a lot of rumination into a short time.</p>
          <p class="story-end"><b>It was an absolute nothing.</b> The partner just sent the email off quickly. If I’d been able to stop and say, “Wait, wait, wait. Am I sure that’s true?” it would’ve saved me a lot of completely unnecessary anguish.</p>
        </div>
        <div class="story-vis" aria-hidden="true">
          <div class="phone">
            <div class="note"><span class="from">Partner</span><span class="msg-t">Come to my office now.</span></div>
          </div>
          <div class="thoughts">
            <span>What did I mess up?</span>
            <span>I’m off the case.</span>
            <span>What if I’m fired?</span>
          </div>
        </div>
      </div>
    </div>

    <div class="col">
      <p class="body" style="margin-top:36px">For extra power, follow up with any of these questions:</p>
      <ol class="qs">
        <li>What evidence do I have that this thought is true?</li>
        <li>Is there any evidence this thought might not be true?</li>
        <li>Are there any assumptions hidden in this thought?</li>
        <li>Is there an alternative scenario that’s just as plausible?</li>
      </ol>

      <details class="fold" id="going-further">
      <summary><span class="fold-in">Going further: name the distortion, replace the thought</span></summary>
      <ul class="pts">
        <li><b>Name the distortion.</b> A cognitive behavioral therapy (CBT) app, like Quirk CBT (iPhone) or What’s Up? (Android), lists the main cognitive distortions and walks you through the process.</li>
        <li><b>Replace the thought.</b> After challenging it, swap in a more helpful and less distorted one:</li>
      </ul>
      <div class="swap">
        <p class="old"><s>“I’m going to mess up this presentation.”</s></p>
        <span class="swap-ar" aria-hidden="true">&darr;</span>
        <p class="new">“I can’t know how this presentation will go, but I do know I’ve prepared extensively, so I’ve set myself up to do a good job.”</p>
      </div>
      </details>
    </div>
  </section>

  {/* ============ Part 2 band ============ */}
  <section class="part" aria-labelledby="part2">
    <div class="wide" style="max-width:calc(940px + 2*var(--gutter))">
      <h2 id="part2">30-second mood boosters</h2>
      <p class="part-lead">Three mental habits that research has shown to increase the experience of positive emotions and cultivate overall well-being. Conveniently, they all start with G.</p>
    </div>
  </section>

  {/* ============ 4: Gratitude (no cheat sheet; from the delivery) ============ */}
  <section class="principle" id="gratitude">
    <div class="col">
      <header class="ph"><span class="num" aria-hidden="true">4</span><h2>Gratitude</h2></header>
      <p class="lead">Studies indicate grateful people are happier, less stressed, and less prone to anxiety and depression. You can cultivate gratitude through practice.</p>

      <h3 class="sub">The gratitude journal</h3>
      <p class="body">At the end of each day, write down <b>three things that went well</b> that day. Each one can be just a sentence. It’s apparently even more effective if you also write down <b>why</b> each one happened, in a way that connects it to something positive about yourself.</p>
      <p class="quick"><b>The 30-second version:</b> whenever something good happens, jot it down right there and then.</p>

      <h3 class="sub">The gratitude visit</h3>
    </div>
    <div class="wide" style="max-width:calc(940px + 2*var(--gutter))">
      <ol class="steps4">
        <li><span class="mk">1</span><span>Think of someone who has shown you incredible kindness, ideally someone you’ve never fully thanked.</span></li>
        <li><span class="mk">2</span><span>Write them a short letter: what they did for you, how it affected you, how it made your life better.</span></li>
        <li><span class="mk">3</span><span>Reach out and say you’d like to get together or catch up. You don’t have to explain why.</span></li>
        <li><span class="mk">4</span><span>When you’re together, read the letter aloud. In person is probably the most powerful, but Zoom or the phone works well too.</span></li>
      </ol>
    </div>
  </section>

  {/* ============ 5: Generosity (no cheat sheet; from the delivery) ============ */}
  <section class="principle alt" id="generosity">
    <div class="col">
      <header class="ph"><span class="num" aria-hidden="true">5</span><h2>Generosity</h2></header>
      <p class="lead">Being generous toward other people is good not just for them, but for you.</p>
      <p class="body">Studies have shown that giving time, effort, money, or items is associated with better physical health and even a longer lifespan, and a large body of research shows it improves well-being and even mental health.</p>
      <div class="card bonus">
        <h3>Give to someone specific</h3>
        <p>Research indicates that <b>targeted giving</b>, to identifiable individuals rather than a broad class of people, yields an additional benefit: it’s apparently associated with decreases in anxiety.</p>
        <p><b>Pro bono</b> is an incredible way to engage in targeted giving, using your skills as an attorney.</p>
      </div>
      <p class="quick"><b>The 30-second version:</b> one small act of giving, like grabbing something from the printer for someone, or giving a buck to someone on the street.</p>
    </div>
  </section>

  {/* ============ 6: Goodwill (cheat sheet: Goodwill Meditation) ============ */}
  <section class="principle" id="goodwill">
    <div class="col">
      <header class="ph"><span class="num" aria-hidden="true">6</span><h2>Goodwill</h2></header>
      <p class="lead">By goodwill, I mean a specific mental state: the heartfelt wish for others to be happy.</p>
      <p class="body">Research indicates that goodwill practices increase positive emotions and appear to improve well-being, even (according to one study) when you’re confronted with the distress of others.</p>
      <p class="body">Whenever you encounter people, in person or virtually, silently wish them well by saying in your mind:</p>
      <p class="borrow-line">“May you be happy.”</p>
      <p class="body">It takes two seconds each time and won’t interrupt your day.</p>

      <div class="gw2">
      <div class="uses">
        <h3>When to use it</h3>
        <ul>
          <li>Before or after a contentious call, meeting, or negotiation</li>
          <li>When you find yourself getting angry or frustrated with adversaries, clients, or colleagues</li>
          <li>When your mood is low or you’re feeling down</li>
        </ul>
      </div>

      <div class="listen">
        <div class="listen-h"><b>Guided goodwill meditation</b><span>About 11 minutes, guided by Jon</span></div>
        <audio controls preload="metadata" src="/uploads/goodwill-meditation-guided.mp3">
          <a href="/uploads/goodwill-meditation-guided.mp3">Play the guided goodwill meditation</a>
        </audio>
      </div>
      </div>

      <details class="fold" id="full-practice">
        <summary><span class="fold-in">The full practice, step by step</span></summary>
        <p class="body">Bring to mind someone you love. Reflect that this person is a human being like you: seeking happiness, wishing not to suffer, enduring hardships. Then mentally recite these phrases, using them as anchors for attention:</p>
        <p class="borrow-line phrases">{PHRASES.map((p) => <span>“{p}”</span>)}</p>
        <p class="body">Repeat for any or all of the following:</p>
        <ul class="pts">
          <li>A neutral person</li>
          <li>A difficult person</li>
          <li>Everyone on earth</li>
          <li>Yourself (highly recommended)</li>
        </ul>
      </details>
    </div>
  </section>

  {/* ============ More tools ============ */}
  <section class="toolkit" id="more">
    <div class="col">
      <h2 class="more-h">Two more tools, and further reading</h2>

      <details class="fold" id="tool-noting">
        <summary><span class="fold-in">Deconstructing anxiety</span></summary>
        <p class="body">A simple, powerful mindfulness practice that doubles as a method for working with anxiety. Let your attention float freely. As it drifts, various sights, sounds, sensations, and thoughts may grab your attention and stand out. As this happens, notice whatever stands out most, and give it a light mental label:</p>
        <ul class="labels">
          <li><b>“Seeing”</b><span>for sights</span></li>
          <li><b>“Hearing”</b><span>for sounds</span></li>
          <li><b>“Feeling”</b><span>for physical sensations</span></li>
          <li><b>“Thinking”</b><span>for anything mental</span></li>
          <li><b>“Don’t know”</b><span>when you’re not sure what’s standing out</span></li>
        </ul>
        <p class="body">It’s accessible even when the mind is agitated or unable to focus, and well suited to short bursts of on-the-go practice. Use it any time you feel anxious or overwhelmed: before depositions, court appearances, client pitches, business development opportunities, high-pressure calls or meetings.</p>
      </details>

      <details class="fold" id="tool-sleep">
        <summary><span class="fold-in">Getting to sleep</span></summary>
        <p class="body">As with anxiety, resisting sleeplessness only exacerbates it. Being less concerned with falling asleep will help you sleep better, and you can’t will yourself to become sleepy. So use the half-hour rule:</p>
        <ol class="cycle">
          <li>If you’re not falling asleep, don’t lie there and “keep trying.” It will only stress you.</li>
          <li>After roughly 20 to 30 minutes (don’t watch a clock), get up.</li>
          <li>Go into a different room, do something relaxing for 20 to 30 minutes, then go back to bed.</li>
          <li>If you become sleepy, great. If not, don’t worry about it. Just repeat the process as many times as you need.</li>
        </ol>
        <p class="remember"><b>Remember:</b> missing sleep is very common and isn’t a big deal.</p>
      </details>

      <details class="fold" id="reading">
        <summary><span class="fold-in">Further reading</span></summary>
        <ul class="reading">
          {READING.map((r) => (
            <li><a href={r.url} target="_blank" rel="noopener"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M3 13h10"/></svg><span>{r.name}</span><em>PDF</em></a></li>
          ))}
        </ul>
      </details>
    </div>
  </section>

  </main>

  {/* ============ Close ============ */}
  <footer class="close" aria-label="Let's keep talking">
    <div class="wide close-in" style="max-width:calc(880px + 2*var(--gutter))">
      <img src="/images/jon-headshot-botanical.webp" alt="Jon Krop" width="600" height="744" loading="lazy" />
      <div>
        <h2>Let’s keep talking</h2>
        <p>Questions, ideas to bounce around, or any way I can be helpful? Never hesitate to drop me a line: <a href="mailto:jon@teamflourish.com">jon@teamflourish.com</a></p>
        <p class="sig">Jon Krop &middot; Founder and CEO, Flourish Legal Well-Being</p>
      </div>
    </div>
    <div class="foot">
      <div class="wide foot-in">
        <img src="/images/logo-orange.png" alt="Flourish Legal Well-Being" width="120" />
        <a href="https://teamflourish.com">teamflourish.com</a>
      </div>
    </div>
  </footer>

  {/* Jump links into a closed toggle (contents links, shared #anchors, back/forward) open it first. */}
  <script is:inline>
    (function(){
      function target(hash){
        if(!hash||hash.length<2)return null;
        try{return document.getElementById(decodeURIComponent(hash.slice(1)));}catch(e){return null;}
      }
      function openAround(el){
        var opened=false,d=el&&el.closest('details');
        while(d){if(!d.open){d.open=true;opened=true;}d=d.parentElement&&d.parentElement.closest('details');}
        return opened;
      }
      // Before the browser follows an in-page link, so it scrolls to the opened content.
      document.addEventListener('click',function(e){
        var a=e.target.closest&&e.target.closest('a[href^="#"]');
        if(a)openAround(target(a.getAttribute('href')));
      },true);
      function sync(){var el=target(location.hash);if(openAround(el))el.scrollIntoView();}
      window.addEventListener('hashchange',sync);
      sync();
      window.addEventListener('beforeprint',function(){[].forEach.call(document.querySelectorAll('details.fold'),function(d){d.open=true;});});
    })();
  </script>
</PlaybookLayout>

<style>
  /* A reference page: tighter rhythm than the layout's default sections. */
  .principle{padding:40px 0;}
  .hero-in{padding-top:40px;padding-bottom:56px;}
  .hero .logo{margin-bottom:30px;}
  .close{padding-top:56px;}
  .lead{font-size:21px;margin-bottom:16px;}
  .ph{margin-bottom:16px;}
  .intro{padding:40px 0 0;}
  .intro .big{font-size:24px;max-width:50ch;}
  .contents{padding-top:24px;padding-bottom:48px;}

  /* ---------- hero dial ---------- */
  .dial{justify-self:center;display:flex;flex-direction:column;align-items:center;gap:20px;margin:0;}
  .dial-ring{position:relative;width:210px;height:210px;}
  .dial-ring svg{width:100%;height:100%;transform:rotate(-90deg);}
  .dial-track{fill:none;stroke:rgba(255,255,255,.08);stroke-width:14;}
  .dial-dash{fill:none;stroke:var(--accent-soft);stroke-width:14;stroke-dasharray:0.62 0.38;opacity:.9;}
  .dial-mid{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
  .dial-n{font-family:var(--serif);font-weight:600;font-size:72px;line-height:.9;color:#fff;}
  .dial-u{font-size:14px;font-weight:700;letter-spacing:.06em;color:#9FB3AD;margin-top:6px;}
  .dial figcaption{text-align:center;max-width:30ch;}
  .dial-q{display:block;font-family:var(--serif);font-style:italic;font-size:28px;line-height:1.2;color:#fff;}
  .dial-src{display:block;font-size:14px;color:#9FB3AD;margin-top:10px;line-height:1.45;}

  /* ---------- contents ---------- */
  .groups{display:grid;grid-template-columns:1fr 1fr;gap:28px;}
  .grp{font-family:var(--serif);font-weight:600;font-size:24px;line-height:1.2;color:var(--ink);margin:0 0 14px;}
  .cards3{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
  .cards3 a{display:flex;flex-direction:column;justify-content:space-between;gap:16px;height:100%;min-height:88px;padding:14px 16px 12px;background:var(--paper-2);border-top:3px solid var(--ink);text-decoration:none;color:var(--ink);transition:transform .18s ease,box-shadow .18s ease,border-color .18s;}
  .cards3 a:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(18,50,47,.12);border-top-color:var(--accent);}
  .cards3 .n{font-family:var(--serif);font-size:40px;line-height:.8;color:var(--accent);}
  .cards3 .t{font-family:var(--serif);font-size:18.5px;line-height:1.2;font-weight:500;text-wrap:balance;}
  .also-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px;margin-top:18px;}
  .also{font-size:16px;color:var(--dim);}
  .also-row .legend{margin-top:0;}

  /* ---------- shared bits ---------- */
  .sub{font-family:var(--serif);font-weight:600;font-size:26px;line-height:1.15;color:var(--ink);margin:28px 0 10px;}
  .body{font-size:17px;line-height:1.58;margin:0 0 12px;}
  .body b{color:var(--ink);}

  /* The 30-second version of a practice (sage, not peach: it describes, it isn't a line to say). */
  .quick{margin:20px 0 4px;padding:14px 18px;background:var(--sage);border:1px solid var(--sage-line);font-size:17px;line-height:1.5;color:var(--body);}
  .quick b{color:var(--ink);}

  /* Collapsible extras: native details, closed by default. */
  .fold{margin:28px 0 0;}
  .fold > summary{display:block;list-style:none;cursor:pointer;}
  .fold > summary::-webkit-details-marker{display:none;}
  .fold-in{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 18px;background:#fff;border:1px solid var(--hair);border-left:3px solid var(--ink);font-family:var(--sans);font-weight:700;font-size:17px;line-height:1.3;color:var(--ink);transition:border-color .15s;}
  .fold-in::after{content:"+";flex:none;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;border:2px solid var(--ink);font:600 20px/1 var(--sans);}
  .fold[open] > summary .fold-in::after{content:"\2212";}
  .fold > summary:hover .fold-in{border-left-color:var(--accent);}
  .fold > summary:focus-visible{outline:none;}
  .fold > summary:focus-visible .fold-in{outline:2px solid var(--accent);outline-offset:2px;}
  .fold[open] > summary{margin-bottom:20px;}

  /* ---------- 1: arousal diagram ---------- */
  .arousal{display:grid;grid-template-columns:1fr 110px 1fr 96px 1fr;align-items:start;margin:24px 0 0;}
  .st{background:#fff;border:1px solid var(--hair);border-top:3px solid var(--ink);padding:18px 18px 16px;box-shadow:0 10px 30px rgba(18,50,47,.06);}
  .st b{display:block;font-family:var(--serif);font-weight:600;font-size:26px;line-height:1.1;color:var(--ink);}
  .st .lvl{display:inline-block;margin:8px 0 10px;font-size:12.5px;font-weight:700;color:var(--dim);background:var(--sage);padding:3px 9px;border-radius:999px;}
  .st p{font-size:15px;line-height:1.5;}
  .st.calm{margin-top:72px;}
  .st.exc{border-top-color:var(--accent);}
  .hop{display:flex;flex-direction:column;align-items:center;gap:8px;padding:0 8px;text-align:center;font-size:13.5px;font-weight:700;line-height:1.3;color:var(--ink);}
  .hop .ar{position:relative;display:block;width:100%;height:2px;background:var(--ink);}
  .hop.far{margin-top:124px;}
  .hop.far .ar{background:repeating-linear-gradient(90deg,var(--dim) 0 6px,transparent 6px 11px);}
  .hop.far .ar::before{content:"";position:absolute;left:-2px;top:-5px;border:6px solid transparent;border-right:9px solid var(--dim);border-left:0;}
  .hop.near{margin-top:50px;}
  .hop.near .ar{background:var(--accent);}
  .hop.near .ar::after{content:"";position:absolute;right:-2px;top:-5px;border:6px solid transparent;border-left:9px solid var(--accent);border-right:0;}

  /* ---------- 2: breathing ---------- */
  .core2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:22px 0 0;}
  .core{background:var(--paper-2);border-top:3px solid var(--ink);padding:20px 20px 18px;}
  .core h3{font-family:var(--serif);font-weight:600;font-size:22px;color:var(--ink);margin:0 0 8px;}
  .core p{font-size:15.5px;line-height:1.55;}
  .rate{margin-top:14px;display:grid;gap:8px;}
  .rate-row{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;}
  .dots{display:flex;gap:4px;}
  .dots i{display:block;width:9px;height:9px;border-radius:50%;background:var(--dim);opacity:.55;}
  .dots i.maybe{opacity:.2;}
  .rate-row.slow .dots i{background:var(--accent);opacity:.9;width:11px;height:11px;margin:0 3px 0 0;}
  .rl{font-size:13px;font-weight:700;color:var(--dim);}

  .patterns{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin:8px 0 0;align-items:stretch;}
  .pat{background:#fff;border:1px solid var(--hair);padding:18px 18px 16px;box-shadow:0 10px 30px rgba(18,50,47,.05);}
  .pat-h b{display:block;font-family:var(--serif);font-weight:600;font-size:21px;color:var(--ink);}
  .pat-h span{display:block;font-size:14px;font-weight:700;color:var(--dim);margin:2px 0 14px;}
  .cells{display:flex;gap:8px;}
  .seg{display:flex;flex-wrap:wrap;gap:3px;align-content:flex-start;}
  .seg em{flex-basis:100%;font-style:normal;font-size:11.5px;font-weight:800;color:var(--ink);margin-bottom:3px;}
  .seg i{display:block;width:14px;height:22px;border-radius:3px;}
  .seg.in i{background:var(--ink);}
  .seg.out i{background:#8FB0A6;}
  .pat-n{font-size:14.5px;line-height:1.45;color:var(--dim);margin-top:12px;}
  .box{position:relative;width:100px;height:100px;margin:10px auto 16px;border:3px solid var(--ink);}
  .box .side{position:absolute;font-size:11.5px;font-weight:800;color:var(--ink);white-space:nowrap;background:#fff;padding:0 4px;}
  .box .t{top:-9px;left:50%;transform:translateX(-50%);}
  .box .b{bottom:-9px;left:50%;transform:translateX(-50%);}
  .box .r{right:-9px;top:50%;transform:translate(50%,-50%) rotate(90deg);}
  .box .l{left:-9px;top:50%;transform:translate(-50%,-50%) rotate(-90deg);}

  /* ---------- 3: questions + story ---------- */
  ol.qs{list-style:none;counter-reset:q;display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:4px 0 0;}
  ol.qs li{counter-increment:q;position:relative;background:#fff;border:1px solid var(--hair);padding:11px 14px 11px 42px;font-family:var(--serif);font-size:17px;line-height:1.35;color:var(--ink);}
  ol.qs li::before{content:counter(q);position:absolute;left:15px;top:12px;font:800 13px var(--sans);color:var(--dim);}

  .story{display:grid;grid-template-columns:1.25fr 1fr;gap:12px 36px;align-items:start;margin:28px 0 0;background:#fff;border:1px solid var(--hair);padding:26px 30px;box-shadow:0 14px 36px rgba(18,50,47,.08);}
  .story-txt h3{font-family:var(--serif);font-weight:600;font-size:28px;line-height:1.15;color:var(--ink);margin-bottom:14px;}
  .story-txt p{font-size:16.5px;line-height:1.55;margin-bottom:10px;}
  .story-vis{display:flex;flex-direction:column;gap:14px;padding-top:52px;}
  .phone{background:#2F3A38;border-radius:18px;padding:16px;}
  .note{display:block;background:#fff;border-radius:10px;padding:10px 14px;}
  .note .from{display:block;font-size:12px;font-weight:800;color:var(--dim);}
  .note .msg-t{display:block;font-size:16px;font-weight:700;color:var(--ink);margin-top:2px;}
  .thoughts{display:flex;flex-wrap:wrap;gap:8px;}
  .thoughts span{font-family:var(--serif);font-style:italic;font-size:16.5px;color:var(--ink);background:var(--paper-2);border:1px solid var(--hair);padding:6px 12px;border-radius:16px 16px 16px 4px;}
  .thoughts span:nth-child(2){margin-left:14px;}
  .story-txt .story-end{border-top:1px dashed var(--hair);padding-top:12px;margin:4px 0 0;}
  .story-end b{color:var(--ink);}

  .swap{margin:14px 0 0 28px;display:flex;flex-direction:column;gap:6px;}
  .swap p{font-family:var(--serif);font-size:18px;line-height:1.4;padding:12px 16px;}
  .swap .old{color:var(--dim);background:var(--paper);border:1px dashed var(--hair);}
  .swap .new{color:var(--ink);background:#fff;border:1px solid var(--hair);border-left:3px solid var(--ink);}
  .swap-ar{font-size:20px;color:var(--ink);padding-left:16px;}

  /* ---------- part band ---------- */
  .part{background:var(--ink);color:#DCE5E1;padding:30px 0 34px;position:relative;overflow:hidden;}
  .part::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 50% 70% at 100% 0%,rgba(240,93,35,.14),transparent 60%);pointer-events:none;}
  .part .wide{position:relative;}
  .part h2{font-family:var(--serif);font-weight:600;font-size:36px;line-height:1.05;color:#fff;letter-spacing:-.01em;}
  .part-lead{font-family:var(--serif);font-size:19px;line-height:1.4;color:#C9D8D3;margin:8px 0 0;max-width:60ch;}

  /* ---------- 4: gratitude ---------- */
  .steps4{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:0;}
  .steps4 li{display:flex;flex-direction:column;gap:10px;background:var(--paper-2);border-top:3px solid var(--ink);padding:16px 16px 18px;font-size:15.5px;line-height:1.5;color:var(--body);}
  .steps4 .mk{font-family:var(--serif);font-weight:600;font-size:34px;line-height:.9;color:var(--ink);}

  /* ---------- 5: generosity ---------- */
  .card.bonus{border-top-color:var(--accent);margin-top:22px;}
  .card.bonus p:last-child{margin-bottom:0;}

  /* ---------- 6: goodwill ---------- */
  .phrases{display:flex;flex-direction:column;gap:2px;}
  .gw2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:22px 0 0;align-items:stretch;}
  .uses{margin:0;background:var(--sage);border-left:3px solid var(--ink);padding:16px 20px;}
  .uses h3{font-family:var(--serif);font-weight:600;font-size:20px;color:var(--ink);margin-bottom:8px;}
  .uses ul{list-style:none;display:grid;gap:8px;}
  .uses li{position:relative;padding-left:20px;font-size:16px;line-height:1.5;}
  .uses li::before{content:"";position:absolute;left:0;top:11px;width:10px;height:2px;background:var(--ink);}
  .listen{margin:0;background:#fff;border:1px solid var(--hair);padding:18px 20px;}
  .listen-h b{display:block;font-family:var(--serif);font-weight:600;font-size:21px;color:var(--ink);}
  .listen-h span{display:block;font-size:14.5px;color:var(--dim);margin:2px 0 12px;}
  .listen audio{display:block;width:100%;}

  /* ---------- more tools ---------- */
  .toolkit{padding:40px 0 48px;}
  .more-h{font-family:var(--serif);font-weight:600;font-size:34px;line-height:1.1;color:var(--ink);margin-bottom:4px;}
  .toolkit .fold{margin-top:14px;}
  .toolkit .fold-in{border-color:var(--sage-line);border-left-color:var(--ink);}
  ul.labels{list-style:none;display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 16px;}
  ul.labels li{display:flex;flex-direction:column;gap:2px;background:#fff;padding:10px 14px;border-top:3px solid var(--ink);min-width:120px;flex:1 1 120px;}
  ul.labels b{font-family:var(--serif);font-size:19px;color:var(--ink);}
  ul.labels span{font-size:13.5px;line-height:1.35;color:var(--dim);}
  ol.cycle{list-style:none;counter-reset:c;display:grid;gap:8px;}
  ol.cycle li{counter-increment:c;position:relative;padding:10px 14px 10px 50px;background:#fff;border:1px solid var(--sage-line);font-size:16px;line-height:1.5;}
  ol.cycle li::before{content:counter(c);position:absolute;left:12px;top:9px;width:26px;height:26px;border-radius:50%;background:var(--ink);color:#fff;font:800 13px/26px var(--sans);text-align:center;}
  .remember{margin-top:14px;font-size:16.5px;}
  .remember b{color:var(--ink);}

  ul.reading{list-style:none;display:grid;gap:0;background:#fff;border:1px solid var(--sage-line);padding:8px 20px;}
  .reading a{display:flex;align-items:baseline;gap:10px;padding:10px 0;border-bottom:1px solid var(--hair);text-decoration:none;color:var(--ink);font-size:15.5px;line-height:1.4;}
  .reading li:last-child a{border-bottom:0;}
  .reading a:hover span{text-decoration:underline;text-decoration-color:var(--accent);}
  .reading svg{flex:none;width:14px;height:14px;position:relative;top:2px;color:var(--ink);}
  .reading a span{flex:1;}
  .reading em{flex:none;font-style:normal;font-size:11px;font-weight:800;color:var(--dim);}

  /* ---------- responsive ---------- */
  @media (max-width:1000px){
    .dial{justify-self:start;flex-direction:row;align-items:center;gap:26px;}
    .dial-ring{width:170px;height:170px;flex:none;}
    .dial-n{font-size:56px;}
    .dial figcaption{text-align:left;}
    .groups{grid-template-columns:1fr;gap:36px;}
  }
  @media (max-width:820px){
    .cards3{grid-template-columns:1fr;gap:0;border-top:3px solid var(--ink);}
    .cards3 a{flex-direction:row;justify-content:flex-start;align-items:baseline;gap:16px;min-height:0;padding:14px 4px;background:none;border:0;border-bottom:1px solid var(--hair);}
    .cards3 a:hover{transform:none;box-shadow:none;}
    .cards3 .n{font-size:30px;line-height:1;min-width:22px;}
    .arousal{grid-template-columns:1fr;gap:0;}
    .st.calm{margin-top:0;}
    .hop,.hop.far,.hop.near{margin:0;flex-direction:row;justify-content:flex-start;padding:12px 0 12px 18px;border-left:2px solid var(--ink);margin-left:24px;text-align:left;}
    /* Stacked: the distance between cards carries the point (far from calm, close to excitement). */
    .hop.far{border-left-style:dashed;border-left-color:var(--dim);align-items:center;min-height:150px;}
    .hop.near{border-left:3px solid var(--accent);padding:4px 0 4px 18px;min-height:0;}
    .hop .ar{display:none;}
    .patterns{grid-template-columns:1fr;}
    .story{grid-template-columns:1fr;padding:26px 22px;}
    .story-vis{padding-top:0;}
    .gw2{grid-template-columns:1fr;}
    .steps4{grid-template-columns:1fr 1fr;}
  }
  @media (max-width:700px){
    .principle{padding:40px 0;}
    .lead{font-size:20px;}
    .intro{padding-top:40px;}
    .intro .big{font-size:23px;}
    .dial{flex-direction:column;align-items:flex-start;}
    .dial-ring{width:150px;height:150px;}
    .dial-q{font-size:24px;}
    .grp{font-size:22px;}
    .sub{font-size:23px;margin-top:36px;}
    .body{font-size:17px;}
    .core2{grid-template-columns:1fr;}
    ol.qs{grid-template-columns:1fr;}
    .steps4{grid-template-columns:1fr;}
    .swap{margin-left:0;}
    .part{padding:52px 0 56px;}
    .part h2{font-size:34px;}
    .part-lead{font-size:19px;}
    .story-txt h3{font-size:25px;}
    .more-h{font-size:28px;}
  }

  @media print{
    .dial-track{stroke:var(--hair);}
    .dial-n,.dial-q{color:var(--ink) !important;}
    .dial-u,.dial-src{color:var(--body) !important;}
    .dial-dash{stroke:var(--accent);}
    .part{background:#fff !important;color:var(--body) !important;border:2px solid var(--ink);}
    .part::before{display:none;}
    .part h2,.part-lead{color:var(--ink) !important;}
    .listen audio{display:none;}
    .seg i,.dots i,ol.cycle li::before,.hop .ar{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
    .story,.arousal,.patterns,.steps4,.core2,.uses,.card{break-inside:avoid;}
    .cards3 a:hover{transform:none;}
    .ph,.part,.sub{break-inside:avoid;break-after:avoid;}
  }
</style>
