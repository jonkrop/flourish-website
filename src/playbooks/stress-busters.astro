  .seg.out i{background:#8FB0A6;}
  .pat-n{font-size:14.5px;line-height:1.45;color:var(--dim);margin-top:12px;}
  .box{position:relative;width:100px;height:100px;margin:10px auto 16px;border:3px solid var(--ink);}
  .box .side{position:absolute;font-size:11.5px;font-weight:800;color:var(--ink);white-space:nowrap;background:#fff;padding:0 4px;}
  .box .t{top:-9px;left:50%;transform:translateX(-50%);}
  .box .b{bottom:-9px;left:50%;transform:translateX(-50%);}
  .box .r{right:-9px;top:50%;transform:translate(50%,-50%) rotate(90deg);}
  .box .l{left:-9px;top:50%;transform:translate(-50%,-50%) rotate(-90deg);}

  /* Breathe-along pacer. The orb's scale carries the breath; JS sets the timing per phase. */
  .pacer{display:grid;grid-template-columns:1fr 300px;gap:28px;align-items:center;margin:22px 0 8px;padding:26px 28px;background:var(--ink);color:#DCE5E1;position:relative;overflow:hidden;}
  .pacer::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 85% 50%,rgba(143,176,166,.18),transparent 65%);pointer-events:none;}
  .pacer > *{position:relative;}
  .pacer h3{font-family:var(--serif);font-weight:600;font-size:28px;line-height:1.1;color:#fff;margin-bottom:8px;}
  .pacer-side > p{font-size:15.5px;line-height:1.5;color:#C9D8D3;margin-bottom:16px;max-width:42ch;}
  .pacer-pick{display:grid;gap:8px;margin-bottom:16px;}
  .pacer-pick button{display:flex;justify-content:space-between;align-items:baseline;gap:12px;width:100%;padding:10px 14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.16);border-radius:6px;color:#fff;font:600 15.5px var(--sans);text-align:left;cursor:pointer;transition:background .15s,border-color .15s;}
  .pacer-pick button span{font-weight:600;font-size:13.5px;color:#9FB3AD;}
  .pacer-pick button:hover{border-color:rgba(255,255,255,.4);}
  .pacer-pick button[aria-pressed="true"]{background:#fff;color:var(--ink);border-color:#fff;}
  .pacer-pick button[aria-pressed="true"] span{color:var(--dim);}
  .pacer-go{padding:11px 26px;border:0;border-radius:999px;background:var(--accent-deep);color:#fff;font:800 15px var(--sans);cursor:pointer;}
  .pacer-go:hover{background:var(--accent);}
  .pacer button:focus-visible{outline:2px solid var(--accent-soft);outline-offset:2px;}
  .pacer-stage{position:relative;display:flex;align-items:center;justify-content:center;width:300px;height:300px;border-radius:50%;border:1px dashed rgba(255,255,255,.18);}
  .orb{width:280px;height:280px;border-radius:50%;background:radial-gradient(circle at 40% 35%,#B9D0C8,#8FB0A6 60%,#6F948A);box-shadow:0 0 60px rgba(143,176,166,.35);transform:scale(.5);transition-property:transform;transition-timing-function:ease-in-out;}
  /* The words sit over the orb at a fixed size, so they stay readable at every point of the breath. */
  .orb-txt{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;}
  .orb-w{font:800 17px var(--sans);color:var(--ink);}
  .orb-n{font-family:var(--serif);font-weight:600;font-size:40px;line-height:1;color:var(--ink);margin-top:6px;min-height:40px;}

  .addons{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .addons > div{display:flex;flex-direction:column;gap:10px;background:var(--paper-2);border-top:3px solid var(--ink);padding:14px 16px 16px;}
  .addons svg{width:30px;height:30px;}
  .addons p{font-size:15.5px;line-height:1.5;}
  .addons b{color:var(--ink);}

  /* ---------- 3: questions + story ---------- */
  ol.qs{list-style:none;counter-reset:q;display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:4px 0 0;}
  ol.qs li{counter-increment:q;position:relative;background:#fff;border:1px solid var(--hair);padding:11px 14px 11px 42px;font-family:var(--serif);font-size:17px;line-height:1.35;color:var(--ink);}
  ol.qs li::before{content:counter(q);position:absolute;left:15px;top:12px;font:800 13px var(--sans);color:var(--dim);}

  .story{display:grid;grid-template-columns:1.25fr 1fr;gap:12px 36px;align-items:start;margin:28px 0 0;background:#fff;border:1px solid var(--hair);padding:26px 30px;box-shadow:0 14px 36px rgba(18,50,47,.08);}
  .story-txt h3{font-family:var(--serif);font-weight:600;font-size:28px;line-height:1.15;color:var(--ink);margin-bottom:14px;}
  .story-txt p{font-size:16.5px;line-height:1.55;margin-bottom:10px;}
  .story-vis{display:flex;flex-direction:column;gap:14px;padding-top:52px;}
  .phone{background:#2F3A38;border-radius:18px;padding:16px;}
  .note{display:block;background:#fff;border-radius:10px;padding:10px 14px;}
  .note .from{display:block;font-size:12px;font-weight:800;color:var(--dim);}
  .note .msg-t{display:block;font-size:16px;font-weight:700;color:var(--ink);margin-top:2px;}
  .thoughts{display:flex;flex-wrap:wrap;gap:8px;}
  .thoughts span{font-family:var(--serif);font-style:italic;font-size:16.5px;color:var(--ink);background:var(--paper-2);border:1px solid var(--hair);padding:6px 12px;border-radius:16px 16px 16px 4px;}
  .thoughts span:nth-child(2){margin-left:14px;}
  .story-txt .story-end{border-top:1px dashed var(--hair);padding-top:12px;margin:4px 0 0;}
  .story-end b{color:var(--ink);}

  .swap{margin:14px 0 0 28px;display:flex;flex-direction:column;gap:6px;}
  .swap p{font-family:var(--serif);font-size:18px;line-height:1.4;padding:12px 16px;}
  .swap .old{color:var(--dim);background:var(--paper);border:1px dashed var(--hair);}
  .swap .new{color:var(--ink);background:#fff;border:1px solid var(--hair);border-left:3px solid var(--ink);}
  .swap-ar{font-size:20px;color:var(--ink);padding-left:16px;}

  /* ---------- part band ---------- */
  .part{background:var(--ink);color:#DCE5E1;padding:30px 0 34px;position:relative;overflow:hidden;}
  .part::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 50% 70% at 100% 0%,rgba(240,93,35,.14),transparent 60%);pointer-events:none;}
  .part .wide{position:relative;}
  .part h2{font-family:var(--serif);font-weight:600;font-size:36px;line-height:1.05;color:#fff;letter-spacing:-.01em;}
  .part-lead{font-family:var(--serif);font-size:19px;line-height:1.4;color:#C9D8D3;margin:8px 0 0;max-width:60ch;}

  /* ---------- 4: gratitude ---------- */
  .journal-wrap{display:grid;grid-template-columns:1fr 330px;gap:40px;align-items:center;margin:28px 0 0;}
  /* Wide screens: the text lines up with the column above; the notebook hangs out to the right. */
  @media (min-width:1000px){.journal-wrap{padding-left:140px;grid-template-columns:1fr 300px;}}
  /* A ruled notebook page: three entries, each a "went well" line and a "why" line. */
  .journal{margin:0;background:#fff;border:1px solid var(--hair);border-left:22px solid var(--sage);padding:20px 22px 22px;box-shadow:0 14px 36px rgba(18,50,47,.10);transform:rotate(1.2deg);background-image:repeating-linear-gradient(transparent 0 31px,rgba(18,50,47,.07) 31px 32px);}
  .journal figcaption{font-family:var(--serif);font-style:italic;font-size:19px;color:var(--ink);margin-bottom:10px;}
  .j-entry{display:flex;gap:12px;align-items:flex-start;margin-top:12px;}
  .j-n{flex:none;font-family:var(--serif);font-weight:600;font-size:26px;line-height:1;color:var(--ink);width:18px;}
  .j-entry > div{flex:1;display:grid;grid-template-columns:auto 1fr;gap:6px 10px;align-items:end;}
  .j-l{font-size:12px;font-weight:800;color:var(--ink);}
  .j-l.why{color:var(--dim);padding-left:14px;}
  .j-line{display:block;height:2px;margin-bottom:3px;background:repeating-linear-gradient(90deg,var(--hair) 0 5px,transparent 5px 8px);}

  .visit{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:0;position:relative;}
  .visit li{position:relative;display:flex;flex-direction:column;gap:10px;font-size:15.5px;line-height:1.5;color:var(--body);background:var(--paper-2);padding:0 16px 18px;margin-top:31px;border-top:3px solid var(--ink);}
  .visit .v-ic{display:flex;align-items:center;justify-content:center;width:62px;height:62px;margin:-33px 0 0;border-radius:50%;background:#fff;border:2px solid var(--ink);}
  .visit .v-ic svg{width:30px;height:30px;}
  .visit .mk{font-family:var(--serif);font-weight:600;font-size:30px;line-height:.9;color:var(--ink);}
  .letter{display:grid;gap:0;background:#fff;border:1px solid var(--hair);padding:6px 12px;}
  .letter span{font-family:var(--serif);font-style:italic;font-size:15.5px;color:var(--ink);padding:6px 0;border-bottom:1px dashed var(--hair);}
  .letter span:last-child{border-bottom:0;}

  /* ---------- 5: generosity ---------- */
  /* Giving on the left, what research links it to on the right. */
  .give{display:grid;grid-template-columns:260px 1fr;margin:28px 0 0;background:#fff;border:1px solid var(--hair);box-shadow:0 10px 30px rgba(18,50,47,.06);}
  .give-in{position:relative;background:var(--ink);color:#fff;padding:22px 24px;display:flex;flex-direction:column;justify-content:center;gap:14px;}
  .give-in::after{content:"";position:absolute;right:-14px;top:50%;width:26px;height:26px;transform:translateY(-50%) rotate(45deg);background:var(--ink);}
  .give-h{font-family:var(--serif);font-weight:600;font-size:30px;line-height:1;}
  .give-what{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;}
  .give-what li{position:relative;padding-left:16px;font-family:var(--serif);font-size:19px;line-height:1.3;color:#DCE5E1;}
  .give-what li::before{content:"";position:absolute;left:0;top:10px;width:7px;height:7px;border-radius:50%;background:var(--accent-soft);}
  .give-out{display:grid;padding:10px 26px 10px 40px;}
  .give-row{display:grid;grid-template-columns:170px 1fr;gap:16px;align-items:center;padding:14px 0;}
  .give-row + .give-row{border-top:1px dashed var(--hair);}
  .give-src{font-size:15px;font-weight:700;line-height:1.35;color:var(--ink);}
  .give-row ul{list-style:none;display:flex;flex-wrap:wrap;gap:8px;}
  .give-row li{font-family:var(--serif);font-size:19px;color:var(--ink);background:var(--sage);border:1px solid var(--sage-line);padding:6px 14px;}

  .target{display:grid;grid-template-columns:1fr 300px;gap:32px;align-items:center;margin:16px 0 0;background:#fff;border:1px solid var(--hair);border-top:3px solid var(--ink);padding:24px 28px;box-shadow:0 10px 30px rgba(18,50,47,.06);}
  .target h3{font-family:var(--serif);font-weight:600;font-size:24px;line-height:1.2;color:var(--ink);margin-bottom:10px;}
  .target p{font-size:16.5px;line-height:1.58;margin-bottom:12px;}
  .target p b{color:var(--ink);}
  .probono{display:flex;gap:12px;align-items:flex-start;background:var(--sage);padding:12px 14px;margin:14px 0 0 !important;}
  .probono svg{flex:none;width:28px;height:28px;}
  .target-vis{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .crowd{display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;}
  .crowd span{font-size:12.5px;font-weight:700;line-height:1.3;color:var(--dim);}
  .dots-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;padding:12px;background:var(--paper-2);}
  .dots-grid i{display:block;width:12px;height:12px;border-radius:50%;background:var(--dim);opacity:.45;}
  .crowd.one .dots-grid i{opacity:.15;}
  .crowd.one .dots-grid i.pick{opacity:1;background:var(--ink);box-shadow:0 0 0 3px #fff,0 0 0 5px var(--ink);}

  .acts{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px;}
  .acts > div{display:flex;gap:14px;align-items:center;background:#fff;border:1px solid var(--hair);padding:14px 16px;}
  .acts svg{flex:none;width:32px;height:32px;}
  .acts p{font-family:var(--serif);font-size:18px;line-height:1.3;color:var(--ink);}

  /* ---------- 6: goodwill ---------- */
  .phrases{display:flex;flex-direction:column;gap:2px;}
  /* The practice in one line: the moment, the wish, the cost. */
  .moment{list-style:none;display:grid;grid-template-columns:1fr 1.7fr 1fr;gap:0;margin:18px 0 0;}
  .moment > li{position:relative;display:flex;flex-direction:column;gap:4px;padding:20px 22px;background:#fff;border:1px solid var(--hair);border-right:0;}
  .moment > li:last-child{border-right:1px solid var(--hair);}
  .moment > li:not(:last-child)::after{content:"";position:absolute;right:-12px;top:44px;z-index:1;width:22px;height:22px;transform:rotate(45deg);background:#fff;border-top:1px solid var(--hair);border-right:1px solid var(--hair);}
  .moment svg{width:40px;height:32px;margin-bottom:8px;}
  .moment b{font-family:var(--serif);font-weight:600;font-size:21px;line-height:1.2;color:var(--ink);}
  .moment > li > span:not(.mini-dial){font-size:15.5px;line-height:1.45;color:var(--body);}
  .moment .m-do{background:var(--paper-2);}
  .moment .m-do::after{background:var(--paper-2) !important;}
  .moment .m-do .borrow-line{margin:12px 0 0;text-align:center;}
  .moment .mini-dial{margin-bottom:8px;}

  .uses3{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
  .uses3 li{display:flex;flex-direction:column;gap:12px;background:var(--sage);border-top:3px solid var(--ink);padding:16px 18px 18px;font-size:16px;line-height:1.5;}
  .uses3 svg{width:32px;height:32px;}

  .listen{display:flex;gap:18px;align-items:center;margin:26px 0 0;background:#fff;border:1px solid var(--hair);padding:16px 20px;box-shadow:0 10px 30px rgba(18,50,47,.06);}
  .listen img{flex:none;width:76px;height:76px;border-radius:50%;object-fit:cover;object-position:50% 22%;}
  .listen > div{flex:1;min-width:0;}
  .listen-h b{display:block;font-family:var(--serif);font-weight:600;font-size:21px;color:var(--ink);}
  .listen-h span{display:block;font-size:14.5px;color:var(--dim);margin:2px 0 10px;}
  .listen audio{display:block;width:100%;}

  /* Widening circles of goodwill: someone you love at the center, everyone on earth at the edge. */
  .rings-wrap{display:flex;align-items:center;gap:24px;margin:6px 0 0;}
  .rings{position:relative;flex:none;width:360px;height:360px;}
  .rings ul{list-style:none;}
  .rings li,.rings .r0{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);border-radius:50%;border:2px solid var(--ink);display:flex;justify-content:center;}
  .rings span{font-size:13px;font-weight:800;color:var(--ink);background:var(--paper);padding:0 6px;margin-top:-9px;height:18px;line-height:18px;white-space:nowrap;}
  .rings .r0{width:110px;height:110px;align-items:center;background:var(--sage);border-color:var(--ink);}
  .rings .r0 span{margin:0;background:none;white-space:normal;text-align:center;line-height:1.25;height:auto;padding:0 12px;font-family:var(--serif);font-size:16px;font-weight:600;}
  .rings .r1{width:190px;height:190px;opacity:.95;}
  .rings .r2{width:270px;height:270px;opacity:.85;}
  .rings .r3{width:350px;height:350px;border-style:dashed;}
  .self{display:flex;flex-direction:column;gap:2px;padding:14px 18px;border-left:3px solid var(--ink);background:var(--sage);}
  .self b{font-family:var(--serif);font-size:20px;font-weight:600;color:var(--ink);}
  .self span{font-size:14px;color:var(--dim);}

  /* ---------- more tools ---------- */
  .toolkit{padding:40px 0 48px;}
  .more-h{font-family:var(--serif);font-weight:600;font-size:34px;line-height:1.1;color:var(--ink);margin-bottom:4px;}
  .toolkit .fold{margin-top:14px;}
  .toolkit .fold-in{border-color:var(--sage-line);border-left-color:var(--ink);}
  ul.labels{list-style:none;display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 16px;}
  ul.labels li{display:flex;flex-direction:column;gap:2px;background:#fff;padding:10px 14px;border-top:3px solid var(--ink);min-width:120px;flex:1 1 120px;}
  ul.labels b{font-family:var(--serif);font-size:19px;color:var(--ink);}
  ul.labels span{font-size:13.5px;line-height:1.35;color:var(--dim);}
  /* The half-hour rule as a loop: four steps left to right, then back to the start. */
  ol.cycle{list-style:none;counter-reset:c;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
  ol.cycle li{counter-increment:c;position:relative;padding:44px 14px 14px;background:#fff;border:1px solid var(--sage-line);font-size:15px;line-height:1.5;}
  ol.cycle li::before{content:counter(c);position:absolute;left:14px;top:12px;width:26px;height:26px;border-radius:50%;background:var(--ink);color:#fff;font:800 13px/26px var(--sans);text-align:center;}
  .loop{display:block;width:100%;height:40px;margin-top:-2px;fill:none;stroke:var(--ink);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke;}
  .loop path{vector-effect:non-scaling-stroke;}
  .remember{margin-top:14px;font-size:16.5px;}
  .remember b{color:var(--ink);}

  ul.reading{list-style:none;display:grid;gap:0;background:#fff;border:1px solid var(--sage-line);padding:8px 20px;}
  .reading a{display:flex;align-items:baseline;gap:10px;padding:10px 0;border-bottom:1px solid var(--hair);text-decoration:none;color:var(--ink);font-size:15.5px;line-height:1.4;}
  .reading li:last-child a{border-bottom:0;}
  .reading a:hover span{text-decoration:underline;text-decoration-color:var(--accent);}
  .reading svg{flex:none;width:14px;height:14px;position:relative;top:2px;color:var(--ink);}
  .reading a span{flex:1;}
  .reading em{flex:none;font-style:normal;font-size:11px;font-weight:800;color:var(--dim);}

  /* ---------- responsive ---------- */
  @media (max-width:1000px){
    .dial{justify-self:start;flex-direction:row;align-items:center;gap:26px;}
    .dial-ring{width:170px;height:170px;flex:none;}
    .dial-n{font-size:56px;}
    .groups{grid-template-columns:1fr;gap:36px;}
  }
  @media (max-width:820px){
    .cards3{grid-template-columns:1fr;gap:0;border-top:3px solid var(--ink);}
    .cards3 a{flex-direction:row;justify-content:flex-start;align-items:baseline;gap:16px;min-height:0;padding:14px 4px;background:none;border:0;border-bottom:1px solid var(--hair);}
    .cards3 a:hover{transform:none;box-shadow:none;}
    .cards3 .n{font-size:30px;line-height:1;min-width:22px;}
    .arousal{grid-template-columns:1fr;gap:0;}
    .st.calm{margin-top:0;}
    .hop,.hop.far,.hop.near{margin:0;flex-direction:row;justify-content:flex-start;padding:12px 0 12px 18px;border-left:2px solid var(--ink);margin-left:24px;text-align:left;}
    /* Stacked: the distance between cards carries the point (far from calm, close to excitement). */
    .hop.far{border-left-style:dashed;border-left-color:var(--dim);align-items:center;min-height:150px;}
    .hop.near{border-left:3px solid var(--accent);padding:4px 0 4px 18px;min-height:0;}
    .hop .ar{display:none;}
    .patterns{grid-template-columns:1fr;}
    .story{grid-template-columns:1fr;padding:26px 22px;}
    .story-vis{padding-top:0;}
    .chain{grid-template-columns:1fr 1fr;gap:16px 0;}
    .chain li:nth-child(2){border-right:1px solid var(--hair);}
    .chain li:nth-child(2)::after{display:none;}
    .pacer{grid-template-columns:1fr;justify-items:center;padding:24px 20px 28px;}
    .pacer-side{justify-self:stretch;}
    .journal-wrap{grid-template-columns:1fr;gap:28px;}
    .journal{max-width:360px;}
    .visit{grid-template-columns:1fr 1fr;row-gap:20px;}
    .give{grid-template-columns:1fr;}
    .give-in::after{right:auto;left:50%;top:auto;bottom:-14px;transform:translateX(-50%) rotate(45deg);}
    .give-out{padding:22px 20px 8px;}
    .target{grid-template-columns:1fr;padding:22px;}
    .target-vis{max-width:320px;}
    .moment{grid-template-columns:1fr;}
    .moment > li{border-right:1px solid var(--hair);border-bottom:0;}
    .moment > li:last-child{border-bottom:1px solid var(--hair);}
    .moment > li:not(:last-child)::after{right:auto;left:30px;top:auto;bottom:-12px;transform:rotate(135deg);}
    .uses3{grid-template-columns:1fr;}
    .uses3 li{flex-direction:row;align-items:flex-start;}
    .uses3 svg{flex:none;}
    ol.cycle{grid-template-columns:1fr 1fr;}
    .loop{display:none;}
    .rings-wrap{flex-direction:column;align-items:flex-start;}
  }
  @media (max-width:700px){
    .principle{padding:40px 0;}
    .lead{font-size:20px;}
    .intro{padding-top:40px;}
    .intro .big{font-size:23px;}
    .dial{flex-direction:column;align-items:flex-start;}
    .dial-ring{width:150px;height:150px;}
    .grp{font-size:22px;}
    .sub{font-size:23px;margin-top:36px;}
    .body{font-size:17px;}
    .core2{grid-template-columns:1fr;}
    ol.qs{grid-template-columns:1fr;}
    .big-line{font-size:25px;padding:18px 20px;}
    .outcomes{grid-template-columns:1fr;}
    .outcomes li{flex-direction:row;align-items:center;}
    .outcomes svg{flex:none;}
    .chain{grid-template-columns:1fr;gap:0;}
    .chain li{border-right:1px solid var(--hair);border-bottom:0;min-height:0;padding:14px 18px 18px;}
    .chain li.end{border-bottom:1px solid var(--hair);}
