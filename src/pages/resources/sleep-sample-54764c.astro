---
// DRAFT (2026-10-09), hidden: unguessable slug, noindex (PlaybookLayout default), linked from nowhere.
// Early look at installment 1 of the drip-format tasting menu (Sleep: the half-hour rule).
// Copy comes verbatim from the task's card-draft.md (head-of-sales-and-marketing/tasks/
// sleep-drip-sample-installment/); composed labels are listed in that task's report.
// Video slot: storyboard key frames rendered from video/scene.html (same task folder).
// Poll and "Coming up" vote run in DEMO MODE: client-side only, no network requests, nothing stored.
// Rules: ../../../../playbook-guide.md (no eyebrows, no copy buttons, orange/peach only for the
// word-for-word line to say, ~660px measure, only the chapter bar floats).
import PlaybookLayout from '../../layouts/PlaybookLayout.astro';
import PlaybookFoliage from '../../components/PlaybookFoliage.astro';

const CHAPTERS = [
  { id: 'technique', n: '1', short: 'Technique' },
  { id: 'video', n: '2', short: 'Video' },
  { id: 'take', n: '3', short: 'Your take' },
  { id: 'coming', n: '4', short: 'Coming up' },
];

const UP = '/uploads/sleep-sample-54764c';
const FRAMES = [
  { src: `${UP}/frame-1.webp`, time: '0:08', at: 7.6, alt: 'A dark bedroom drawn in thin cream lines: a bed, a nightstand, and a window with a crescent moon. A small glowing dot, you, rests on the bed.' },
  { src: `${UP}/frame-2.webp`, time: '0:24', at: 24.2, alt: 'The same bedroom. The clock on the nightstand is blurred so it can’t be read, and a faint arc around the bed slowly fills.' },
  { src: `${UP}/frame-3.webp`, time: '0:41', at: 41.0, alt: 'Both rooms. The dot has crossed the doorway, leaving a fine trail, and sits in an armchair in the next room under a warm lamp, with an open book.' },
  { src: `${UP}/frame-4.webp`, time: '0:50', at: 50.2, alt: 'The lamp is off and the dot is back in bed. Its trail has closed into a loop between the two rooms.' },
  { src: `${UP}/frame-5.webp`, time: '1:24', at: 84.0, alt: 'Both rooms, the window glowing with first light, under the closing line: By giving up on falling asleep right this second, you give yourself more of a chance to fall asleep later.' },
];
const VIDEO_LEN = 87;

const STEPS = [
  { n: '1', area: 's1', lead: 'After lying awake for 20 to 30 minutes, get out of bed.', rest: 'Don’t watch a clock: when you have a rough sense it’s been 20 to 30 minutes, get up.' },
  { n: '2', area: 's2', lead: 'Go into the next room and do something relaxing.', rest: 'Read a book, or listen to an audiobook or a podcast. If doing some dishes is relaxing for you, do that. It’s best not to look at your phone or check your email.' },
  { n: '3', area: 's3', lead: 'Go back to bed', rest: 'after 20 to 30 minutes or as soon as you start to get drowsy, whichever comes first, and see what happens.', inline: true },
  { n: '4', area: 's4', lead: 'Still awake after 20 to 30 minutes? Get up again.', rest: 'Repeat as many times as you need to. Even if it takes you a few cycles, you’ll still probably fall asleep sooner than you would have otherwise.' },
];

const TILES = [
  { n: 2, t: 'Keeping your cool when the pressure is on' },
  { n: 3, t: 'Getting people’s best work without burning them out' },
  { n: 4, t: 'Feedback associates actually take in' },
  { n: 5, t: 'Saying no without saying no' },
  { n: 6, t: 'A 30-second fix for a distracting phone' },
  { n: 7, t: 'Two-minute resets for a stressful day' },
  { n: 8, t: 'A small morning habit with a big lift' },
  { n: 9, t: 'A 30-second ritual before you speak' },
  { n: 10, t: 'Riding out a craving' },
  { n: 11, t: 'Handing one thing off this week' },
  { n: 12, t: 'What to say when a colleague is struggling' },
  { n: 13, t: 'Eating well on a lawyer’s schedule' },
];

const ASA = 'https://www.americanbar.org/groups/lawyer_assistance/resources/lap_programs_by_state/';
---
<PlaybookLayout
  title="Sleep: The Half-Hour Rule"
  description="One technique to try tonight: what to do when you’re lying in bed and just can’t fall asleep."
  chapters={CHAPTERS}
>
  {/* ============ Hero ============ */}
  <section class="hero foliage" id="top">
    <PlaybookFoliage />
    <div class="wide hero-in">
      <div>
        <img class="logo" src="/images/logo-orange.png" alt="Flourish Legal Well-Being" width="168" />
        <h1>Sleep</h1>
        <p class="sub-title">One technique to try tonight</p>
        <p class="from">From Jon Krop, <a href="https://teamflourish.com">Flourish Legal Well-Being</a></p>
      </div>
      <figure class="inst" aria-label="Installment 1 of 13">
        <div class="inst-ring">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <circle class="inst-track" cx="100" cy="100" r="86" pathLength="13" />
            <circle class="inst-on" cx="100" cy="100" r="86" pathLength="13" />
          </svg>
          <div class="inst-mid"><span class="inst-n">1</span><span class="inst-of">of 13</span></div>
        </div>
      </figure>
    </div>
  </section>

  <main>
  {/* ============ The card: the half-hour rule ============ */}
  <section class="principle tech" id="technique">
    <div class="col">
      <header class="ph"><h2>The Half-Hour Rule</h2></header>
      <p class="lead">What to do when you’re lying in bed and just can’t fall asleep, or you wake up in the middle of the night and can’t get back to sleep.</p>
      <div class="trust">
        <img src="/images/jon-headshot-botanical.webp" alt="" width="600" height="744" loading="lazy" />
        <p>I struggled with insomnia for many years. This is the single most useful thing I got from CBTi, cognitive behavioral therapy for insomnia: a set of evidence-based strategies devised by sleep psychologists.</p>
      </div>
      <h3 class="sub">How it works</h3>
    </div>

    <div class="wide loop-wrap">
      <div class="loop">
        <div class="ring" aria-hidden="true">
          <svg viewBox="0 0 300 300">
            <circle class="ring-track" cx="150" cy="150" r="118" />
            {[45, 135, 225, 315].map((a) => (
              <g transform={`rotate(${a} 150 150)`}><path class="ring-chev" d="M144 26 L152 32 L144 38" /></g>
            ))}
            <g class="ring-orbit"><circle class="ring-you-glow" cx="150" cy="32" r="13" /><circle class="ring-you" cx="150" cy="32" r="5" /></g>
            {[0, 90, 180, 270].map((a, i) => {
              const r = (a - 90) * Math.PI / 180;
              const x = 150 + 118 * Math.cos(r), y = 150 + 118 * Math.sin(r);
              return (<g><circle class="ring-node" cx={x} cy={y} r="21" /><text class="ring-num" x={x} y={y + 7.5} text-anchor="middle">{i + 1}</text></g>);
            })}
            <path class="ring-moon" d="M161 132 a22 22 0 1 0 0 36 a18 18 0 1 1 0 -36 z" />
          </svg>
        </div>
        <ol class="steps">
          {STEPS.map((s) => (
            <li class={`step-c ${s.area}`}>
              <span class="step-n" aria-hidden="true">{s.n}</span>
              <p><b>{s.lead}</b> {s.rest}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="col">
      <h3 class="sub">Why it works</h3>
      <p class="body">When we lie in bed trying to will ourselves to become sleepy, all that does is create anxiety. The more we resist sleeplessness, the more we entrench it. So the best thing is to stop resisting.</p>

      <blockquote class="pull">
        <p>By giving up on falling asleep right this second, you give yourself more of a chance to fall asleep later.</p>
      </blockquote>

      <p class="say-h">A line to say to yourself:</p>
      <p class="borrow-line">“I’m not sleepy right now. No big deal.”</p>

      <div class="watch misses"><div class="wk">Common misses</div><ul>
        <li>Checking the clock to see if it’s been 30 minutes.</li>
        <li>Picking up your phone or checking email while you’re up.</li>
        <li>Staying in bed “just a little longer” to see if sleep comes.</li>
      </ul></div>
    </div>
  </section>

  {/* ============ Video (storyboard for the early look) + narration placeholder ============ */}
  <section class="night" id="video">
    <div class="wide night-in">
      <h2 class="night-h">The half-hour rule, in 85 seconds</h2>
      <div class="player" data-player>
        <div class="stage">
          {FRAMES.map((f, i) => (
            <img src={f.src} alt={f.alt} width="1600" height="900" loading={i === 0 ? 'eager' : 'lazy'} class={i === 0 ? 'on' : ''} data-frame={i} />
          ))}
          <span class="badge">Storyboard</span>
        </div>
        <div class="controls">
          <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" /></svg></span>
          <div class="track" aria-hidden="true">
            <span class="fill" data-fill style={`width:${(FRAMES[0].at / VIDEO_LEN * 100).toFixed(2)}%`}></span>
            {FRAMES.map((f, i) => <span class={`tick${i === 0 ? ' on' : ''}`} style={`left:${(f.at / VIDEO_LEN * 100).toFixed(2)}%`} data-tick={i}></span>)}
          </div>
          <span class="clock" data-clock>{FRAMES[0].time}</span>
        </div>
        <div class="strip" role="group" aria-label="Storyboard key frames">
          {FRAMES.map((f, i) => (
            <button type="button" class={`thumb${i === 0 ? ' on' : ''}`} aria-pressed={i === 0 ? 'true' : 'false'} data-go={i} data-at={(f.at / VIDEO_LEN * 100).toFixed(2)} data-time={f.time}>
              <img src={f.src} alt="" width="1600" height="900" loading="lazy" />
              <span class="sr-only">Frame {i + 1} of 5, at </span><span class="t">{f.time}</span>
            </button>
          ))}
        </div>
      </div>
      <p class="night-cap">The storyboard for the 85-second video: five key frames. The finished video will play right here.</p>

      <div class="narr" aria-disabled="true">
        <button type="button" class="narr-play" disabled aria-label="Play narration (not available yet)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg></button>
        <div class="narr-txt">Narration in Jon’s voice: coming</div>
        <div class="narr-wave" aria-hidden="true">{Array.from({ length: 36 }, (_, i) => <i style={`height:${(4 + Math.round(10 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * .45))))}px`}></i>)}</div>
      </div>
    </div>
  </section>

  {/* ============ Your take: thirst line + anonymous poll (demo mode) ============ */}
  <section class="take" id="take">
    <div class="col">
      <p class="thirst">This is one tool from Sleep Made Simple, a workshop on the greatest hits of CBTi.</p>

      <div class="poll" data-poll>
        <h2 class="poll-q" id="poll-q">Could you use more support with this?</h2>
        <div class="choices" role="group" aria-labelledby="poll-q">
          {['Yes', 'Maybe', 'Not right now'].map((c) => (
            <button type="button" class="choice" aria-pressed="false" data-choice={c}>
              <span class="tick-mark" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4.5 10.5l3.5 3.5 7.5-8" /></svg></span>
              <span>{c}</span>
            </button>
          ))}
        </div>
        <p class="thanks" data-poll-thanks aria-live="polite"></p>

        <div class="share">
          <div class="comment" data-comment>
            <label for="poll-comment">Anything you’d like to share? It’s anonymous: no name, no email.</label>
            <textarea id="poll-comment" rows="4" maxlength="1000" data-comment-box></textarea>
            <div class="comment-row">
              <button type="button" class="send" disabled data-send>Send</button>
              <p class="sent" data-sent aria-live="polite"></p>
            </div>
          </div>
          <aside class="crisis" aria-label="If you’re struggling">
            <p>If you’re struggling, you don’t have to wait. Call or text <a href="https://988lifeline.org/" target="_blank" rel="noopener"><b>988</b></a> (Suicide &amp; Crisis Lifeline, 24/7), reach your firm’s EAP, or contact your state’s <a href={ASA} target="_blank" rel="noopener"><b>Lawyer Assistance Program</b></a>.</p>
          </aside>
        </div>
      </div>
      <p class="demo"><span aria-hidden="true">i</span>Sample page: your answers here aren’t recorded.</p>
    </div>
  </section>

  {/* ============ Coming up: grayed tiles + one-tap vote (demo mode) ============ */}
  <section class="coming" id="coming">
    <div class="wide">
      <div class="coming-head">
        <h2>Coming up</h2>
        <p class="vote-q" data-vote-q>Which of these would help you most?</p>
        <p class="vote-thanks" data-vote-thanks aria-live="polite" hidden>Thanks for voting.</p>
      </div>
      <ol class="tiles" aria-label="Coming up: tap the one that would help you most">
        {TILES.map((x) => (
          <li>
            <button type="button" class="tile" aria-pressed="false" data-tile={x.n}>
              <span class="tile-top">
                <span class="tile-n">{x.n}</span>
                <span class="tile-ico" aria-hidden="true">
                  <svg class="lock" viewBox="0 0 20 20"><rect x="4.5" y="9" width="11" height="8" rx="1.5" /><path d="M7 9V6.5a3 3 0 0 1 6 0V9" /></svg>
                  <svg class="chk" viewBox="0 0 20 20"><path d="M4.5 10.5l3.5 3.5 7.5-8" /></svg>
                </span>
              </span>
              <span class="tile-t">{x.t}</span>
            </button>
          </li>
        ))}
      </ol>
      <p class="demo">
        <span aria-hidden="true">i</span>Sample page: your answers here aren’t recorded.
      </p>
    </div>
  </section>
  </main>

  {/* ============ Close ============ */}
  <footer class="close" aria-label="Let's keep talking">
    <div class="wide close-in" style="max-width:calc(880px + 2*var(--gutter))">
      <img src="/images/jon-headshot-botanical.webp" alt="Jon Krop" width="600" height="744" loading="lazy" />
      <div>
        <h2>Let’s keep talking</h2>
        <p>Questions, ideas to bounce around, or any way I can be helpful? Never hesitate to drop me a line: <a href="mailto:jon@teamflourish.com">jon@teamflourish.com</a></p>
        <p class="sig">Jon Krop &middot; Founder and CEO, Flourish Legal Well-Being</p>
      </div>
    </div>
    <div class="foot">
      <div class="wide foot-in">
        <img src="/images/logo-orange.png" alt="Flourish Legal Well-Being" width="120" />
        <a href="https://teamflourish.com">teamflourish.com</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function(){
      // DEMO MODE: everything below is client-side only. No network requests, nothing stored.

      // Storyboard player: pick a key frame.
      var player = document.querySelector('[data-player]');
      if (player) {
        var imgs = player.querySelectorAll('[data-frame]'), thumbs = player.querySelectorAll('[data-go]'), ticks = player.querySelectorAll('[data-tick]');
        var fill = player.querySelector('[data-fill]'), clock = player.querySelector('[data-clock]');
        function show(i){
          imgs.forEach(function(im, k){ im.classList.toggle('on', k === i); });
          thumbs.forEach(function(b, k){ b.classList.toggle('on', k === i); b.setAttribute('aria-pressed', k === i ? 'true' : 'false'); });
          ticks.forEach(function(t, k){ t.classList.toggle('on', k <= i); });
          fill.style.width = thumbs[i].dataset.at + '%';
          clock.textContent = thumbs[i].dataset.time;
        }
        thumbs.forEach(function(b, k){ b.addEventListener('click', function(){ show(k); }); });
        player.addEventListener('keydown', function(e){
          var cur = [].findIndex.call(thumbs, function(b){ return b.classList.contains('on'); });
          if (e.key === 'ArrowRight' && cur < thumbs.length - 1) { show(cur + 1); thumbs[cur + 1].focus(); e.preventDefault(); }
          if (e.key === 'ArrowLeft' && cur > 0) { show(cur - 1); thumbs[cur - 1].focus(); e.preventDefault(); }
        });
      }

      // Poll: one tap, then a short thank-you. Tapping again changes the answer.
      var poll = document.querySelector('[data-poll]');
      if (poll) {
        var choices = poll.querySelectorAll('[data-choice]'), thanks = poll.querySelector('[data-poll-thanks]');
        choices.forEach(function(btn){
          btn.addEventListener('click', function(){
            choices.forEach(function(b){ b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
            poll.classList.add('answered');
            thanks.textContent = '';
            requestAnimationFrame(function(){ thanks.textContent = 'Thanks. Got it.'; });
          });
        });
        var box = poll.querySelector('[data-comment-box]'), send = poll.querySelector('[data-send]'), sent = poll.querySelector('[data-sent]');
        box.addEventListener('input', function(){ send.disabled = !box.value.trim(); if (box.value.trim()) sent.textContent = ''; });
        send.addEventListener('click', function(){
          if (!box.value.trim()) return;
          box.value = '';
          send.disabled = true;
          sent.textContent = 'Thank you for sharing.';
        });
      }

      // "Coming up" vote: tap a tile to choose it.
      var tiles = document.querySelectorAll('[data-tile]'), q = document.querySelector('[data-vote-q]'), vt = document.querySelector('[data-vote-thanks]');
      tiles.forEach(function(t){
        t.addEventListener('click', function(){
          tiles.forEach(function(o){ o.setAttribute('aria-pressed', o === t ? 'true' : 'false'); });
          q.hidden = true;
          vt.hidden = false;
        });
      });
    })();
  </script>
</PlaybookLayout>

<style>
  /* Page rhythm: a sample installment, tighter than the layout's default sections. */
  .hero-in{padding-top:44px;padding-bottom:64px;}
  .hero .logo{margin-bottom:34px;}
  .hero h1{font-size:76px;}
  .principle{padding:72px 0 80px;}
  .ph{margin-bottom:16px;}
  .lead{font-size:23px;margin-bottom:22px;}
  .close{padding-top:64px;}
  .sub{font-family:var(--serif);font-weight:600;font-size:27px;line-height:1.15;color:var(--ink);margin:44px 0 14px;}
  .body{font-size:18px;line-height:1.6;margin:0 0 12px;}

  /* ---------- hero: installment ring ---------- */
  .inst{justify-self:center;margin:0;}
  .inst-ring{position:relative;width:212px;height:212px;}
  .inst-ring svg{width:100%;height:100%;transform:rotate(-90deg);}
  .inst-track{fill:none;stroke:rgba(255,255,255,.16);stroke-width:9;stroke-dasharray:.84 .16;stroke-dashoffset:-.08;}
  .inst-on{fill:none;stroke:var(--accent-soft);stroke-width:9;stroke-dasharray:.84 12.16;stroke-dashoffset:-.08;}
  .inst-mid{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
  .inst-n{font-family:var(--serif);font-weight:600;font-size:78px;line-height:.85;color:#fff;}
  .inst-of{font-size:15px;font-weight:700;letter-spacing:.06em;color:#B9CAC4;margin-top:8px;}

  /* ---------- the card ---------- */
  .tech .ph h2{font-size:48px;}
  .trust{display:flex;gap:16px;align-items:flex-start;margin:4px 0 0;padding:16px 18px;background:var(--paper-2);border-left:3px solid var(--ink);}
  .trust img{flex:none;width:52px;height:52px;border-radius:50%;object-fit:cover;object-position:50% 6%;}
  .trust p{font-size:16.5px;line-height:1.55;color:var(--body);}

  /* the loop: four steps around a ring */
  .loop-wrap{max-width:calc(1000px + 2*var(--gutter));}
  .loop{display:grid;grid-template-columns:1fr 300px 1fr;grid-template-rows:auto 300px auto;grid-template-areas:". s1 ." "s4 ring s2" ". s3 .";gap:18px 34px;align-items:center;margin:6px 0 0;}
  .ring{grid-area:ring;width:300px;height:300px;}
  .ring svg{width:100%;height:100%;overflow:visible;}
  .ring-track{fill:none;stroke:var(--ink);stroke-width:1.6;opacity:.32;}
  .ring-chev{fill:none;stroke:var(--ink);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;opacity:.55;}
  .ring-node{fill:var(--ink);}
  .ring-num{font-family:var(--serif);font-size:22px;font-weight:600;fill:#fff;}
  .ring-moon{fill:var(--sage-line);}
  .ring-orbit{transform-origin:150px 150px;animation:orbit 24s linear infinite;}
  .ring-you{fill:var(--ink);}
  .ring-you-glow{fill:var(--ink);opacity:.12;}
  @keyframes orbit{to{transform:rotate(360deg);}}
  @media (prefers-reduced-motion:reduce){.ring-orbit{animation:none;transform:rotate(18deg);}}
  .steps{display:contents;list-style:none;}
  .step-c{position:relative;background:#fff;border:1px solid var(--hair);border-top:3px solid var(--ink);padding:18px 20px 18px 20px;box-shadow:0 10px 30px rgba(18,50,47,.06);}
  .step-c p{font-size:16px;line-height:1.55;color:var(--body);}
  .step-c b{display:block;font-family:var(--serif);font-weight:600;font-size:20px;line-height:1.25;color:var(--ink);margin-bottom:6px;}
  .step-c.s3 b{display:inline;font-size:inherit;font-family:inherit;margin:0;}
  .step-c.s3 p{font-family:var(--serif);font-size:20px;line-height:1.3;color:var(--ink);}
  .step-n{display:none;}
  .s1{grid-area:s1;margin:0 -60px;}
  .s3{grid-area:s3;margin:0 -60px;}
  .s2{grid-area:s2;}
  .s4{grid-area:s4;}

  /* pull quote: serif, ink (not orange: it isn't a line to say) */
  .pull{margin:40px 0 36px;padding:30px 0 4px;border-top:1px solid var(--hair);position:relative;}
  .pull::before{content:"\201C";position:absolute;top:-6px;left:-4px;font-family:var(--serif);font-size:96px;line-height:1;color:var(--sage-line);}
  .pull p{position:relative;font-family:var(--serif);font-weight:500;font-size:31px;line-height:1.28;color:var(--ink);text-wrap:balance;padding-left:46px;}
  .say-h{font-size:16px;font-weight:700;color:var(--ink);margin:0 0 -6px;}
  .misses{margin-top:28px;}

  /* ---------- video: night band ---------- */
  .night{background:#0B1A18;color:#DCE5E1;padding:76px 0 84px;position:relative;overflow:hidden;}
  .night::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 55% 60% at 50% 30%,rgba(237,243,241,.05),transparent 70%);pointer-events:none;}
  .night-in{position:relative;max-width:calc(1000px + 2*var(--gutter));}
  .night-h{font-family:var(--serif);font-weight:600;font-size:40px;line-height:1.08;color:#fff;margin:0 0 26px;letter-spacing:-.01em;text-wrap:balance;}
  .player{background:#050B0A;border:1px solid rgba(255,255,255,.08);border-radius:14px;overflow:hidden;box-shadow:0 30px 70px rgba(0,0,0,.45);}
  .stage{position:relative;aspect-ratio:16/9;background:#091513;}
  .stage img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .5s ease;}
  .stage img.on{opacity:1;}
  .badge{position:absolute;top:14px;left:14px;font-size:12px;font-weight:700;letter-spacing:.04em;color:#DCE5E1;background:rgba(5,11,10,.6);border:1px solid rgba(255,255,255,.14);padding:5px 10px;border-radius:999px;}
  .controls{display:flex;align-items:center;gap:16px;padding:12px 18px;border-top:1px solid rgba(255,255,255,.06);}
  .play{flex:none;display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;border:1.5px solid rgba(255,255,255,.22);opacity:.5;}
