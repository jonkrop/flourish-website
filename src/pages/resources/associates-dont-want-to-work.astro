  <script is:inline>
    (function(){
      // Sticky chapter bar: show after the hero, highlight the current chapter, track progress
      var bar=document.getElementById('bar'),prog=document.getElementById('prog'),hero=document.getElementById('top');
      var links=[].slice.call(bar.querySelectorAll('a[data-ch]'));
      var secs=links.map(function(a){return document.getElementById(a.dataset.ch);});
      var current=null;
      var ticking=false;
      function update(){
        ticking=false;
        var y=window.scrollY,h=document.documentElement.scrollHeight-window.innerHeight,heroH=hero.offsetHeight,vh=window.innerHeight;
        var active=null;
        secs.forEach(function(s,i){if(s&&s.getBoundingClientRect().top<vh*0.35)active=i;});
        bar.classList.toggle('on',y>heroH-60);
        if(active!==current){
          links.forEach(function(a,i){a.classList.toggle('active',i===active);});
          if(active!==null){var a=links[active],ol=a.closest('ol');ol.scrollTo({left:a.offsetLeft-ol.clientWidth/2+a.offsetWidth/2,behavior:'smooth'});}
          current=active;
        }
        prog.style.transform='scaleX('+(h>0?Math.min(1,y/h):0)+')';
      }
      function onScroll(){if(!ticking){ticking=true;requestAnimationFrame(update);}}
      window.addEventListener('scroll',onScroll,{passive:true});
      window.addEventListener('resize',onScroll);
      update();
    })();
  </script>
