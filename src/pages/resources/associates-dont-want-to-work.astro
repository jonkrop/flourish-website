---
// Standalone resource page - intentionally NOT wrapped in the site layout.
// The web-native playbook from Jon's NALP webinar (2026-10-06),
// "Associates Don't Want to Work Anymore": Helping Partners Motivate Today's Associates.
// Written from the delivery transcript, in Jon's voice. Paper palette shared with beautiful-slideshows.
import '@fontsource-variable/manrope';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500-italic.css';

const HANDOUTS_PDF = '/uploads/Flourish-A-Game-Cheat-Sheets-for-Partners.pdf';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Associates Don&rsquo;t Want to Work Anymore: Helping Partners Motivate Today&rsquo;s Associates | Flourish</title>
  <meta name="description" content="A playbook for PD professionals: five principles for helping partners get associates' A-game, plus the lines to borrow and cheat sheets to share." />
  <meta property="og:title" content="&ldquo;Associates Don&rsquo;t Want to Work Anymore&rdquo;: Helping Partners Motivate Today&rsquo;s Associates" />
  <meta property="og:description" content="Five principles for helping partners get associates' A-game, plus the lines to borrow." />
  <meta property="og:type" content="article" />
  <meta property="og:image" content="https://teamflourish.com/images/partners-listen/og.jpg" />
  <link rel="icon" href="/images/lotus.png" />
  <style is:global>
    :root{
      --ground:#E7E1D6;
      --paper:#FEFCFA;
      --ink:#12322F;
      --body:#2B403A;
      --dim:#5C6E67;
      --accent:#F05D23;
      --accent-deep:#C4471A;
      --peach:#FCEEE9;
      --peach-line:#F2D8CC;
      --sage:#EDF3F1;
      --sage-line:#D3E1DC;
      --hair:rgba(18,50,47,.14);
      --serif:"Newsreader",Georgia,"Times New Roman",serif;
      --sans:"Manrope Variable","Manrope","Segoe UI",system-ui,sans-serif;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;}
    html,body{background:var(--ground);color:var(--body);font-family:var(--sans);-webkit-font-smoothing:antialiased;}
    body{padding:44px 20px 72px;display:flex;justify-content:center;align-items:flex-start;}
    a{color:var(--accent-deep);}

    .doc{
      width:100%;max-width:780px;background:var(--paper);position:relative;
      border:1px solid rgba(240,93,35,.38);
      box-shadow:0 20px 60px rgba(18,50,47,.20);
      padding:64px 66px 50px;
    }

    /* ---------- masthead ---------- */
    .logo{display:block;width:188px;height:auto;margin-bottom:26px;}
    .eyebrow{font-weight:700;font-size:12.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--dim);}
    .title{font-family:var(--serif);font-weight:600;font-size:46px;line-height:1.06;letter-spacing:-.005em;color:var(--ink);text-wrap:balance;}
    .sub-title{font-family:var(--serif);font-weight:500;font-size:30px;line-height:1.15;color:var(--ink);margin-top:8px;text-wrap:balance;}
    .sub{font-family:var(--serif);font-style:italic;font-size:21px;line-height:1.35;color:var(--dim);margin-top:14px;text-wrap:balance;}
    .from{font-size:13.5px;color:var(--dim);margin-top:16px;line-height:1.5;}
    .from b{font-weight:600;color:var(--body);}

    /* ---------- opening chat ---------- */
    .chat{margin:36px 0 30px;border:1px solid var(--hair);border-radius:10px;overflow:hidden;background:#fff;box-shadow:0 2px 14px rgba(18,50,47,.08);}
    .chat-bar{display:flex;align-items:center;gap:8px;padding:10px 16px;background:#F3F1EC;border-bottom:1px solid var(--hair);font-size:12.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--dim);}
    .chat-bar .dot{width:8px;height:8px;border-radius:50%;background:#E05A4E;box-shadow:12px 0 0 #E8B54A,24px 0 0 #6BBF6A;margin-right:28px;}
    .chat-q{padding:18px 20px 6px;font-family:var(--serif);font-size:19px;line-height:1.35;color:var(--ink);}
    .chat-q small{display:block;font-family:var(--sans);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-deep);margin-bottom:6px;}
    .chat-feed{padding:10px 20px 20px;display:flex;flex-wrap:wrap;gap:8px;}
    .msg{font-size:14.5px;line-height:1.35;padding:7px 12px;border-radius:14px 14px 14px 4px;background:var(--sage);color:var(--ink);opacity:0;transform:translateY(6px);animation:pop .45s ease forwards;}
    .msg.yes{font-weight:700;}
    .msg.long{flex-basis:100%;max-width:max-content;font-style:italic;}
    @keyframes pop{to{opacity:1;transform:none;}}
    @media (prefers-reduced-motion:reduce){.msg{animation:none;opacity:1;transform:none;}}

    .intro p{font-size:17px;line-height:1.62;color:var(--body);max-width:64ch;margin-bottom:14px;}
    .intro p.big{font-family:var(--serif);font-size:24px;line-height:1.3;color:var(--ink);font-weight:500;}
    .howto{display:flex;gap:12px;align-items:center;margin-top:6px;font-size:14.5px;color:var(--dim);}
    .howto .chip{flex:none;display:inline-block;width:26px;height:18px;border-radius:3px;background:var(--peach);border:1px solid var(--peach-line);border-left:3px solid var(--accent);}

    /* ---------- contents ---------- */
    .toc{margin:30px 0 4px;background:var(--sage);border-top:2px solid var(--ink);padding:20px 24px 18px;}
    .toc-head{font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--ink);margin-bottom:10px;}
    .toc ol{list-style:none;counter-reset:t;}
    .toc li{border-bottom:1px solid var(--sage-line);}
    .toc li:last-child{border-bottom:0;}
    .toc a{display:flex;gap:14px;align-items:baseline;padding:8px 0;text-decoration:none;color:var(--ink);font-family:var(--serif);font-size:18px;}
    .toc a:hover .t{text-decoration:underline;text-decoration-color:var(--accent);}
    .toc .n{font-family:var(--sans);font-weight:800;font-size:13px;color:var(--accent-deep);min-width:14px;}
    .toc-tools{display:flex;flex-wrap:wrap;gap:18px;margin-top:12px;padding-top:12px;border-top:1px solid var(--sage-line);}
    .toc-tools a,.toc-tools button{font:600 13.5px var(--sans);color:var(--accent-deep);background:none;border:0;cursor:pointer;text-decoration:none;display:inline-flex;gap:6px;align-items:center;padding:0;}
    .toc-tools a:hover,.toc-tools button:hover{text-decoration:underline;}

    .hr{height:2px;background:linear-gradient(90deg,var(--accent),rgba(240,93,35,0));margin:44px 0 40px;border:0;}

    /* ---------- principles ---------- */
    .principle{margin:0;}
    .ph{display:flex;align-items:center;gap:18px;margin-bottom:18px;}
    .ph .num{font-family:var(--serif);font-weight:500;font-size:64px;line-height:.8;color:var(--accent);flex:none;margin-top:2px;}
    
    .ph h2{font-family:var(--serif);font-weight:600;font-size:32px;line-height:1.1;letter-spacing:-.005em;color:var(--ink);text-wrap:balance;}
    .lead{margin:0 0 18px;font-family:var(--serif);font-style:italic;font-weight:500;font-size:23px;line-height:1.32;color:var(--ink);text-wrap:balance;}

    ul.pts{list-style:none;display:flex;flex-direction:column;gap:12px;margin:0 0 6px;}
    ul.pts li{position:relative;padding-left:26px;font-size:17px;line-height:1.56;color:var(--body);}
    ul.pts li::before{content:"";position:absolute;left:0;top:12px;width:13px;height:2px;background:var(--accent);}
    ul.pts b{font-weight:700;color:var(--ink);}
    q,.qt{font-style:normal;}

    h3.sub3{font-family:var(--serif);font-weight:600;font-size:22px;color:var(--ink);margin:30px 0 10px;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;}
    h3.sub3 .for{font-family:var(--sans);font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-deep);}
    p.txt{font-size:17px;line-height:1.56;margin:0 0 12px;}
    p.txt b{color:var(--ink);}
    .cap{font-size:14px;color:var(--dim);font-style:italic;margin:8px 0 0;line-height:1.45;}

    /* ---------- lines to borrow ---------- */
    .borrow{margin:26px 0 0;background:var(--peach);border:1px solid var(--peach-line);border-left:3px solid var(--accent);padding:18px 22px 10px;}
    .borrow-head{font-size:12px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--accent-deep);margin-bottom:8px;display:flex;align-items:center;gap:8px;}
    .borrow ul{list-style:none;}
    .borrow li{display:flex;gap:14px;align-items:flex-start;justify-content:space-between;padding:10px 0;border-top:1px solid var(--peach-line);}
    .borrow li:first-child{border-top:0;}
    .borrow .line{font-family:var(--serif);font-size:19.5px;line-height:1.38;color:var(--ink);}
    .borrow .tag{display:block;font-family:var(--sans);font-size:12px;font-weight:700;letter-spacing:.06em;color:var(--accent-deep);margin-bottom:3px;}
    .borrow .credit{display:block;font-family:var(--sans);font-size:13px;font-style:italic;color:var(--dim);margin-top:3px;}

    /* ---------- email before/after ---------- */
    .emails{display:grid;grid-template-columns:1fr 1.35fr;gap:16px;margin:18px 0 0;align-items:start;}
    .email{background:#fff;border:1px solid var(--hair);border-radius:8px;overflow:hidden;box-shadow:0 2px 10px rgba(18,50,47,.07);}
    .email .bar{display:flex;justify-content:space-between;align-items:center;padding:8px 14px;background:#2F3A38;color:#fff;font-size:12px;font-weight:600;}
    .email .st{font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:3px 8px;border-radius:3px;}
    .email.before .st{background:#B23A2E;}
    .email.after .st{background:var(--accent-deep);}
    .email .meta{font-size:12.5px;color:var(--dim);padding:8px 14px;border-bottom:1px solid var(--hair);}
    .email .body{padding:14px 14px 16px;font-size:15px;line-height:1.55;color:var(--ink);}
    .email .seg{display:block;margin-bottom:6px;}
    .email .lt{display:inline-flex;align-items:center;justify-content:center;width:19px;height:19px;border-radius:3px;background:var(--accent);color:#fff;font-size:11px;font-weight:800;margin-right:7px;position:relative;top:-1px;}

    /* ---------- ladder ---------- */
    .ladder{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;align-items:end;margin:16px 0 0;}
    .rung{background:var(--sage);border:1px solid var(--sage-line);border-top:3px solid var(--ink);padding:12px 12px 12px;font-size:14px;line-height:1.4;color:var(--body);}
    .rung:nth-child(1){min-height:120px;}
    .rung:nth-child(2){min-height:150px;}
    .rung:nth-child(3){min-height:180px;}
    .rung:nth-child(4){min-height:210px;border-top-color:var(--accent);}
    .rung .r{display:block;font-family:var(--serif);font-size:26px;line-height:1;color:var(--accent-deep);margin-bottom:6px;}
    .rung b{display:block;font-size:14.5px;color:var(--ink);margin-bottom:4px;}
    .ladder-axis{display:flex;justify-content:space-between;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);margin-top:8px;}

    /* ---------- blame cards ---------- */
    .cards{display:flex;flex-direction:column;gap:18px;margin:22px 0 0;}
    .card{border:1px solid var(--hair);background:#fff;padding:22px 24px 20px;}
    .card .k{font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--accent-deep);margin-bottom:6px;}
    .card h3{font-family:var(--serif);font-weight:600;font-size:22px;line-height:1.2;color:var(--ink);margin-bottom:6px;}
    .card .hears{font-family:var(--serif);font-style:italic;font-size:17.5px;color:var(--dim);margin-bottom:14px;}
    .card p{font-size:16.5px;line-height:1.56;margin-bottom:12px;}
    .card p b{color:var(--ink);}
    .say{margin:6px 0 14px;padding:14px 18px;background:var(--sage);border-radius:4px 14px 14px 14px;font-family:var(--serif);font-size:18.5px;line-height:1.4;color:var(--ink);position:relative;}
    .say::before{content:"How we put it";display:block;font-family:var(--sans);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin-bottom:6px;}

    /* ---------- objections dialogue ---------- */
    .dialog{display:flex;flex-direction:column;gap:22px;margin:24px 0 0;}
    .ex{display:flex;flex-direction:column;gap:8px;}
    .bub{max-width:86%;padding:12px 16px;line-height:1.45;}
    .bub .who{display:block;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;margin-bottom:4px;}
    .bub.they{align-self:flex-start;background:#fff;border:1px solid var(--hair);border-radius:4px 16px 16px 16px;font-family:var(--serif);font-style:italic;font-size:18px;color:var(--ink);}
    .bub.they .who{color:var(--dim);font-family:var(--sans);font-style:normal;}
    .bub.you{align-self:flex-end;background:var(--peach);border:1px solid var(--peach-line);border-right:3px solid var(--accent);border-radius:16px 4px 16px 16px;font-family:var(--serif);font-size:18px;color:var(--ink);}
    .bub.you .who{color:var(--accent-deep);font-family:var(--sans);}
    .ex .note{align-self:flex-end;max-width:86%;font-size:14.5px;line-height:1.5;color:var(--dim);}
    .ex .note b{color:var(--ink);}

    .biggest{margin:30px 0 0;background:var(--ink);color:#E9EFEC;padding:26px 28px 24px;}
    .biggest .k{font-size:12px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:#F4A07A;margin-bottom:8px;}
    .biggest .q{font-family:var(--serif);font-style:italic;font-size:25px;line-height:1.25;color:#fff;margin-bottom:16px;}
    .biggest .ans{display:flex;gap:20px;align-items:center;margin-bottom:16px;}
    .biggest .ans img{width:112px;height:112px;border-radius:50%;object-fit:cover;flex:none;border:2px solid rgba(255,255,255,.25);}
    .biggest .ans .big{font-family:var(--serif);font-size:30px;line-height:1.15;color:#fff;}
    .biggest .ans .big small{display:block;font-family:var(--sans);font-size:13px;color:#B9C8C3;margin-top:8px;font-style:italic;}
    .biggest p{font-size:16.5px;line-height:1.56;margin-bottom:12px;color:#DCE5E1;}
    .biggest p b{color:#fff;}

    /* ---------- three in's ---------- */
    .ins{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:16px 0 0;}
    .in{background:var(--sage);border:1px solid var(--sage-line);padding:16px 16px 14px;}
    .in .w{font-family:var(--serif);font-size:23px;color:var(--ink);margin-bottom:6px;}
    .in .w span{color:var(--accent-deep);font-weight:600;}
    .in p{font-size:14.5px;line-height:1.5;}



    /* ---------- borrowable lines ---------- */
    .borrow-line{margin:12px 0 16px;padding:14px 18px;background:var(--peach);border:1px solid var(--peach-line);border-left:3px solid var(--accent);font-family:var(--serif);font-size:19.5px;line-height:1.4;color:var(--ink);}
    .card .borrow-line{margin:6px 0 12px;}
    .biggest .wise{font-family:var(--serif);font-style:italic;font-size:19px;line-height:1.4;color:#fff;border-left:3px solid var(--accent);padding:4px 0 4px 16px;margin-top:4px;}
    .biggest .ans .big{color:#F7B08E;}


    /* ---------- objection move ---------- */
    .ex.solo{margin:6px 0 0;}
    .move{margin:30px 0 4px;}
    .move-h{font-family:var(--serif);font-size:20px;line-height:1.35;color:var(--ink);margin-bottom:12px;}
    .move-steps{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
    .move .step{display:flex;gap:14px;align-items:flex-start;background:var(--sage);border:1px solid var(--sage-line);padding:16px 18px;font-size:15.5px;line-height:1.5;}
    .move .step b{display:block;font-family:var(--serif);font-size:21px;font-weight:600;color:var(--ink);margin-bottom:3px;}
    .mv{flex:none;display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:var(--ink);color:#fff;font:800 12px var(--sans);margin-right:8px;position:relative;top:-2px;}
    .move .step .mv{width:30px;height:30px;font-size:14px;margin:2px 0 0;top:0;}
    .bub.you .seg{display:block;}
    .bub.you .seg + .seg{margin-top:6px;}
    @media (max-width:600px){.move-steps{grid-template-columns:1fr;}}

    /* ---------- toolkit ---------- */
    .kit-head{margin:0 0 8px;}
    .kit-head .k{font-size:12px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--accent-deep);}
    .kit-head h2{font-family:var(--serif);font-weight:600;font-size:34px;line-height:1.1;color:var(--ink);margin:6px 0 10px;}
    .kit-head p{font-size:17px;line-height:1.56;max-width:62ch;}
    .tool{margin:28px 0 0;border-top:2px solid var(--ink);padding-top:18px;}
    .tool h3{font-family:var(--serif);font-weight:600;font-size:25px;color:var(--ink);line-height:1.15;}
    .tool .for{display:block;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-deep);margin:6px 0 12px;}
    .tool p{font-size:16.5px;line-height:1.56;margin-bottom:10px;}
    .tool p b{color:var(--ink);}
    .steps{list-style:none;display:grid;gap:10px;margin:12px 0 12px;}
    .steps li{display:grid;grid-template-columns:42px 1fr;gap:12px;align-items:start;font-size:16px;line-height:1.5;}
    .steps .mk{font-family:var(--serif);font-weight:600;font-size:22px;line-height:1.1;color:var(--accent-deep);text-align:center;background:var(--peach);border:1px solid var(--peach-line);border-radius:4px;padding:6px 0;}
    .steps b{display:block;color:var(--ink);font-size:16.5px;}
    .watch{margin:12px 0 4px;background:var(--sage);border:1px solid var(--sage-line);padding:14px 18px;}
    .watch .wk{font-size:11.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--ink);margin-bottom:8px;}
    .watch ul{list-style:none;display:grid;gap:8px;}
    .watch li{position:relative;padding-left:20px;font-size:15.5px;line-height:1.5;}
    .watch li::before{content:"";position:absolute;left:0;top:10px;width:10px;height:2px;background:var(--accent);}
    .watch i{font-family:var(--serif);font-size:16.5px;color:var(--ink);}
    .kit-link{font-size:14.5px;font-weight:600;}
    .sheet{display:inline-block;font-size:13.5px;font-weight:700;color:var(--accent-deep);text-decoration:none;margin:-4px 0 12px;}
    .sheet:hover{text-decoration:underline;}

    /* ---------- start + downloads + close ---------- */
    .start{margin:46px 0 0;text-align:center;padding:34px 30px;border:1px solid var(--peach-line);background:linear-gradient(180deg,var(--peach),var(--paper));}
    .start .k{font-size:12px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--accent-deep);}
    .start .big{font-family:var(--serif);font-weight:600;font-size:34px;line-height:1.1;color:var(--ink);margin:8px 0 12px;}
    .start p{font-size:16.5px;line-height:1.55;max-width:52ch;margin:0 auto;}

    .dl{display:flex;gap:22px;align-items:center;margin:34px 0 0;padding:22px;border:1px solid var(--hair);background:#fff;text-decoration:none;color:inherit;transition:box-shadow .15s,transform .15s;}
    .dl:hover{box-shadow:0 8px 24px rgba(18,50,47,.12);transform:translateY(-1px);}
    .dl img{width:110px;height:auto;border:1px solid var(--hair);flex:none;}
    .dl .k{font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--accent-deep);}
    .dl .name{display:block;font-family:var(--serif);font-weight:600;font-size:23px;color:var(--ink);margin:4px 0 6px;}
    .dl .desc{font-size:15px;line-height:1.5;}
    .dl .go{display:inline-block;margin-top:10px;font-weight:700;font-size:13.5px;color:var(--accent-deep);}

    .close{display:flex;gap:24px;align-items:center;margin:40px 0 0;padding:26px 28px;background:var(--sage);border-top:2px solid var(--ink);}
    .close img{width:104px;height:104px;border-radius:50%;object-fit:cover;object-position:50% 4%;flex:none;}
    .close h2{font-family:var(--serif);font-weight:600;font-size:26px;color:var(--ink);margin-bottom:6px;}
    .close p{font-size:16px;line-height:1.55;}
    .close .sig{font-size:14px;color:var(--dim);margin-top:8px;}

    .foot{margin-top:28px;display:flex;justify-content:space-between;align-items:center;font-size:14px;color:var(--dim);border-top:1px solid var(--hair);padding-top:20px;}
    .foot .mark{font-family:var(--serif);font-style:italic;font-size:16px;color:var(--ink);}
    .foot a{text-decoration:none;}

    @media (max-width:600px){
      body{padding:18px 10px 40px;}
      .doc{padding:38px 22px 32px;}
      .title{font-size:36px;}
      .sub{font-size:19px;}
      .ph .num{font-size:50px;}
      .ph h2{font-size:26px;}
      .lead{font-size:20px;}
      .emails{grid-template-columns:1fr;}
      .ladder{grid-template-columns:1fr 1fr;}
      .rung{min-height:0 !important;}
      .ins{grid-template-columns:1fr;}
      .bub{max-width:94%;}
      .ex .note{max-width:94%;}
      .biggest .ans{flex-direction:column;align-items:flex-start;}
