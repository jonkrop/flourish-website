    @media print{
      .bar,.contents-tools,.kit-index,.chat-bar .dot{display:none !important;}
      body{background:#fff;}
      .hero,.biggest,.close,.toolkit,.principle.alt,.start{background:#fff !important;color:var(--body) !important;}
      .hero::before,.biggest::before{display:none;}
      .hero h1,.biggest .q,.close h2{color:var(--ink) !important;}
      .hero .sub-title,.hero .from,.hero .from a,.biggest p,.biggest p b,.close p,.close p a,.close .sig,.foot-in,.foot a{color:var(--body) !important;}
      .email .ebar,.email .st,.email .lt,.mv{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
      .dl .go{display:none;}
      .chat{box-shadow:none;border:1px solid var(--hair);}
      ul.pts li::before,.watch li::before{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
      .ph,.kit-head h2,.tool-meta{break-after:avoid;}
      .ph h2,.lead{break-inside:avoid;}
      .biggest .ans .big,.biggest .wise{color:var(--ink) !important;}
      .biggest{border:2px solid var(--ink);}
      .msg{animation:none;opacity:1;transform:none;}
      .principle,.toolkit,.start{padding:40px 0;}
      .tool,.card,.ex,.borrow-line,.biggest,.cards5,.ladder{break-inside:avoid;}
      .dl{background:#fff;color:var(--body);border:1px solid var(--hair);}
      .dl .name{color:var(--ink);}
    }
  </style>
