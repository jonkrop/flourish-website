---
// Shared shell for web-native workshop playbooks (process: ../../../playbook-guide.md).
// Design reference: src/pages/resources/associates-dont-want-to-work.astro (built before this
// layout existed; same CSS). Pages supply hero, sections and close as slot content using these classes.
// Rules: no eyebrow labels, no copy buttons, orange/peach = lines readers can borrow word for word.
import '@fontsource-variable/manrope';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500-italic.css';

interface Chapter { id: string; n: string; short: string; }
interface Props {
  title: string;
  description?: string;
  chapters: Chapter[];
  noindex?: boolean;
  // Topic pages: { clientSlug: clientName } so ?client=<slug> shows a back link.
  clientLookup?: Record<string, string>;
}
const { title, description = '', chapters, noindex = true, clientLookup = {} } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {noindex && <meta name="robots" content="noindex" />}
  <title>{title} | Flourish</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" href="/images/lotus.png" />
  <style is:global>
    :root{
      --paper:#FEFCFA;
      --paper-2:#F7F2EA;
      --ink:#12322F;
      --body:#2B403A;
      --dim:#5C6E67;
      --accent:#F05D23;
      --accent-deep:#C4471A;
      --accent-soft:#F4A07A;
      --peach:#FCEEE9;
      --peach-line:#F2D8CC;
      --sage:#EDF3F1;
      --sage-line:#D3E1DC;
      --hair:rgba(18,50,47,.13);
      --serif:"Newsreader",Georgia,"Times New Roman",serif;
      --sans:"Manrope Variable","Manrope","Segoe UI",system-ui,sans-serif;
      --col:660px;
      --wide:1080px;
      --gutter:24px;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;scroll-padding-top:72px;}
    @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto;}}
    body{background:var(--paper);color:var(--body);font-family:var(--sans);-webkit-font-smoothing:antialiased;}
    a{color:var(--ink);text-decoration-color:var(--accent);text-underline-offset:3px;}
    a:hover{color:var(--accent-deep);}
    .col{max-width:calc(var(--col) + 2*var(--gutter));margin:0 auto;padding:0 var(--gutter);}
    .wide{max-width:calc(var(--wide) + 2*var(--gutter));margin:0 auto;padding:0 var(--gutter);}
    .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}

    /* ---------- sticky chapter bar ---------- */
    .bar{position:fixed;top:0;left:0;right:0;z-index:50;background:var(--paper);box-shadow:0 2px 12px rgba(18,50,47,.06);border-bottom:1px solid var(--hair);transform:translateY(-101%);transition:transform .25s ease;}
    .bar.on,.bar:has(:focus-visible){transform:none;}
    .bar-in{max-width:calc(var(--wide) + 2*var(--gutter));margin:0 auto;padding:0 var(--gutter);display:flex;align-items:center;gap:22px;height:56px;}
    .bar-home{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);flex:none;}
    .bar-home img{width:24px;height:24px;}
    .bar ol{position:relative;list-style:none;display:flex;gap:4px;margin-left:auto;overflow-x:auto;scrollbar-width:none;}
    .bar ol::-webkit-scrollbar{display:none;}
    .bar li a{display:flex;align-items:center;gap:7px;padding:7px 11px;border-radius:999px;text-decoration:none;color:var(--dim);font-size:13.5px;font-weight:600;white-space:nowrap;transition:background .15s,color .15s;}
    .bar li a .n{font-family:var(--serif);font-size:16px;font-weight:600;color:var(--accent-deep);}
    .bar li a:hover{background:var(--sage);color:var(--ink);}
    .bar li a.active{background:var(--ink);color:#fff;}
    .bar li a.active .n{color:var(--accent-soft);}
    .bar .prog{position:absolute;left:0;bottom:-1px;height:2px;width:100%;background:var(--accent);transform-origin:0 50%;transform:scaleX(0);}

    /* ---------- hero ---------- */
    .hero{background:var(--ink);color:#E4ECE9;position:relative;overflow:hidden;}
    .hero::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 60% 70% at 92% 10%,rgba(240,93,35,.16),transparent 60%),radial-gradient(ellipse 50% 60% at 0% 100%,rgba(237,243,241,.06),transparent 70%);pointer-events:none;}
    .hero-in{position:relative;display:grid;grid-template-columns:1.08fr 1fr;gap:64px;align-items:center;padding-top:56px;padding-bottom:88px;}
    .hero .logo{display:block;width:168px;height:auto;margin-bottom:44px;}
    .hero h1{font-family:var(--serif);font-weight:600;font-size:60px;line-height:1.02;letter-spacing:-.012em;color:#fff;text-wrap:balance;}
    .hero .sub-title{font-family:var(--serif);font-weight:400;font-size:28px;line-height:1.2;color:#C9D8D3;margin-top:16px;text-wrap:balance;}
    .hero .from{font-size:14.5px;color:#9FB3AD;margin-top:26px;}
    .hero .from a{color:#fff;text-decoration-color:var(--accent);text-underline-offset:3px;}

    /* Foliage variant (opt-in: <section class="hero foliage"> + PlaybookFoliage): the main site's hero photo and orange frame. */
    .hero.foliage{background:#0B1A17;}
    .hero.foliage::before{display:none;}
    .pf-bg,.pf-fg{position:absolute;inset:0;pointer-events:none;}
    .pf-bg img,.pf-fg img{width:100%;height:100%;object-fit:cover;display:block;}
    .pf-bg::after{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 60% 55% at 32% 48%,rgba(5,5,5,.55) 0%,transparent 72%),linear-gradient(to bottom,rgba(5,5,5,.3) 0%,rgba(5,5,5,.06) 40%,rgba(5,5,5,.45) 100%);}
    .pf-frame{position:absolute;top:22px;left:3.5%;right:3.5%;bottom:5%;border:2px solid var(--accent);pointer-events:none;}
    /* Leaves cross only the frame's bottom line, at the lower left. */
    .pf-fg{clip-path:polygon(3% 74%,30% 74%,30% 100%,3% 100%);}
    .hero.foliage .hero-in{z-index:1;max-width:min(calc(var(--wide) + 2*var(--gutter)),calc(93% - 72px));padding-top:64px;padding-bottom:104px;}

    .chat{border-radius:14px;overflow:hidden;background:#fff;box-shadow:0 30px 70px rgba(0,0,0,.35),0 2px 0 rgba(255,255,255,.4) inset;}
    .chat-bar{display:flex;align-items:center;gap:8px;padding:12px 18px;background:#F3F1EC;border-bottom:1px solid var(--hair);font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);}
    .chat-bar .dot{width:9px;height:9px;border-radius:50%;background:#E05A4E;box-shadow:14px 0 0 #E8B54A,28px 0 0 #6BBF6A;margin-right:34px;}
    .chat-q{padding:20px 22px 8px;font-family:var(--serif);font-size:19.5px;line-height:1.38;color:var(--ink);}
    .chat-feed{padding:10px 22px 22px;display:flex;flex-wrap:wrap;gap:8px;}
    .msg{font-size:14.5px;line-height:1.35;padding:7px 12px;border-radius:14px 14px 14px 4px;background:var(--sage);color:var(--ink);opacity:0;transform:translateY(6px);animation:pop .45s ease forwards;}
    .msg.yes{font-weight:700;}
    .msg.long{flex-basis:100%;max-width:max-content;font-style:italic;}
    @keyframes pop{to{opacity:1;transform:none;}}
    @media (prefers-reduced-motion:reduce){.msg{animation:none;opacity:1;transform:none;}}

    /* ---------- intro + contents ---------- */
    .intro{padding:84px 0 24px;}
    .intro .big{font-family:var(--serif);font-size:31px;line-height:1.28;color:var(--ink);font-weight:500;text-wrap:pretty;}
    .intro p.txt{font-size:18px;line-height:1.62;margin-top:20px;}
    .intro p.txt b{color:var(--ink);}
    .legend{display:inline-flex;gap:12px;align-items:center;margin-top:22px;font-size:15px;color:var(--dim);background:var(--paper-2);padding:10px 16px 10px 12px;border-radius:999px;}
    .legend .chip{flex:none;display:inline-block;width:28px;height:18px;border-radius:3px;background:var(--peach);border:1px solid var(--peach-line);border-left:3px solid var(--accent);}

    .contents{padding:40px 0 96px;}
    .toc-head{font-size:12.5px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--ink);margin-bottom:16px;}
    .cards5{list-style:none;display:grid;grid-template-columns:repeat(5,1fr);gap:12px;}
    .cards5 a{display:flex;flex-direction:column;justify-content:space-between;gap:22px;height:100%;min-height:150px;padding:18px 18px 16px;background:var(--paper-2);border:1px solid transparent;border-top:3px solid var(--ink);text-decoration:none;color:var(--ink);transition:transform .18s ease,box-shadow .18s ease,border-color .18s;}
    .cards5 a:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(18,50,47,.12);border-top-color:var(--accent);}
    .cards5 .n{font-family:var(--serif);font-size:44px;line-height:.8;color:var(--accent);}
    .cards5 .t{font-family:var(--serif);font-size:19px;line-height:1.2;font-weight:500;text-wrap:balance;}
    @media (max-width:820px){
      .cards5{grid-template-columns:1fr;gap:0;border-top:3px solid var(--ink);}
      .cards5 a{flex-direction:row;justify-content:flex-start;align-items:baseline;gap:16px;min-height:0;padding:14px 4px;background:none;border:0;border-bottom:1px solid var(--hair);}
      .cards5 a:hover{transform:none;box-shadow:none;}
      .cards5 .n{font-size:30px;line-height:1;min-width:22px;}
      .cards5 .t{font-size:19px;}
    }
    .contents-tools{display:flex;flex-wrap:wrap;gap:12px;margin-top:18px;}
    .btn{display:inline-flex;align-items:center;gap:8px;font:700 14px var(--sans);padding:11px 18px;border-radius:999px;text-decoration:none;cursor:pointer;border:1.5px solid var(--ink);color:var(--ink);background:transparent;transition:background .15s,color .15s;}
    .btn:hover{background:var(--ink);color:#fff;}
    .btn.solid{background:var(--accent-deep);border-color:var(--accent-deep);color:#fff;}
    .btn.solid:hover{background:var(--ink);border-color:var(--ink);}

    /* ---------- principle sections ---------- */
    .principle{padding:104px 0 104px;border-top:1px solid var(--hair);}
    .principle.alt{background:var(--paper-2);border-top-color:transparent;}
    .ph{position:relative;margin-bottom:22px;}
    .ph .num{display:block;font-family:var(--serif);font-weight:400;font-size:112px;line-height:.78;color:var(--accent);margin-bottom:18px;}
    .ph h2{font-family:var(--serif);font-weight:600;font-size:44px;line-height:1.06;letter-spacing:-.01em;color:var(--ink);text-wrap:balance;}
    @media (min-width:1120px){
      .ph .num{position:absolute;right:calc(100% + 36px);top:-6px;margin:0;font-size:150px;}
    }
    .lead{margin:0 0 28px;font-family:var(--serif);font-weight:400;font-size:25px;line-height:1.36;color:var(--ink);text-wrap:pretty;}

    ul.pts{list-style:none;display:flex;flex-direction:column;gap:14px;margin:0 0 6px;}
    ul.pts li{position:relative;padding-left:28px;font-size:18px;line-height:1.6;color:var(--body);}
    ul.pts li::before{content:"";position:absolute;left:0;top:13px;width:14px;height:2px;background:var(--accent);}
    ul.pts b{font-weight:700;color:var(--ink);}
    .trip4{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:14px 0 0 28px;}
    .trip4 li{display:flex;flex-direction:column;gap:8px;background:var(--paper-2);border-top:3px solid var(--ink);padding:14px 14px 16px;font-size:15.5px;line-height:1.45;color:var(--body);}
    .trip4 .mk{font-family:var(--serif);font-weight:600;font-size:34px;line-height:.9;color:var(--accent-deep);}
    .trip4 b{color:var(--ink);}
    @media (max-width:700px){.trip4{grid-template-columns:1fr 1fr;margin-left:0;}}
    .cap{font-size:14.5px;color:var(--dim);font-style:italic;margin:12px 0 0;line-height:1.45;text-align:center;}

    /* ---------- borrowable lines ---------- */
    .borrow-line{position:relative;margin:18px 0 22px;padding:20px 24px 20px 24px;background:var(--peach);border:1px solid var(--peach-line);border-left:4px solid var(--accent);font-family:var(--serif);font-size:21px;line-height:1.42;color:var(--ink);}

    /* ---------- TRIP email before/after ---------- */
    .emails{display:grid;grid-template-columns:1fr 1.35fr;gap:20px;margin:36px 0 0;align-items:start;}
    .email{background:#fff;border:1px solid var(--hair);border-radius:10px;overflow:hidden;box-shadow:0 14px 36px rgba(18,50,47,.10);}
    .email .ebar{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;background:#2F3A38;color:#fff;font-size:12.5px;font-weight:600;}
    .email .st{font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:3px 8px;border-radius:3px;}
    .email.before{opacity:.92;}
    .email.before .st{background:#B23A2E;}
    .email.after .st{background:var(--accent-deep);}
    .email .meta{font-size:12.5px;color:var(--dim);padding:9px 16px;border-bottom:1px solid var(--hair);}
    .email .ebody{padding:16px 16px 18px;font-size:16px;line-height:1.55;color:var(--ink);}
    .email .seg{display:grid;grid-template-columns:96px 1fr;gap:12px;align-items:baseline;margin-bottom:10px;}
    .email .seg:last-child{margin-bottom:0;}
    .email .lt{justify-self:start;display:inline-block;padding:2px 8px;border-radius:4px;background:var(--accent);color:#fff;font-size:12px;font-weight:800;letter-spacing:.02em;white-space:nowrap;line-height:1.5;}

    /* ---------- blame cards ---------- */
    .cards2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:36px 0 0;align-items:stretch;}
    .card{background:#fff;border:1px solid var(--hair);border-top:3px solid var(--ink);padding:26px 26px 22px;box-shadow:0 10px 30px rgba(18,50,47,.06);}
    .card h3{font-family:var(--serif);font-weight:600;font-size:24px;line-height:1.2;color:var(--ink);margin-bottom:10px;}
    .card .hears{font-family:var(--serif);font-style:italic;font-size:18px;line-height:1.4;color:var(--dim);margin-bottom:16px;padding-bottom:16px;border-bottom:1px dashed var(--hair);}
    .card p{font-size:16.5px;line-height:1.58;margin-bottom:12px;}
    .card p b{color:var(--ink);}
    .card .borrow-line{font-size:19px;margin:6px 0 14px;padding:16px 18px;}

    /* ---------- objections ---------- */
    .move-h{font-size:18px;font-weight:700;line-height:1.5;color:var(--ink);margin:0 0 14px;text-wrap:pretty;}
    .move-steps{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:stretch;}
    .move-steps .arrow{align-self:center;font-size:22px;color:var(--accent);}
    @media (min-width:900px){.move-steps{margin:0 -64px;}}
    .step{display:flex;gap:14px;align-items:flex-start;background:var(--sage);border:1px solid var(--sage-line);padding:18px 20px;font-size:16px;line-height:1.5;}
    .step b{display:block;font-family:var(--serif);font-size:22px;font-weight:600;color:var(--ink);margin-bottom:3px;}
    .mv{flex:none;display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:var(--ink);color:#fff;font:800 14px var(--sans);margin-top:2px;}

    .dialog{display:flex;flex-direction:column;gap:30px;margin:48px 0 0;}
    .ex{display:flex;flex-direction:column;gap:10px;}
    .bub{max-width:84%;padding:14px 18px;line-height:1.45;}
    .bub .who{display:block;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;margin-bottom:5px;}
    .bub.they{align-self:flex-start;background:#fff;border:1px solid var(--hair);border-radius:4px 18px 18px 18px;font-family:var(--serif);font-style:italic;font-size:19px;color:var(--ink);box-shadow:0 4px 14px rgba(18,50,47,.05);}
    .bub.they .who{color:var(--dim);font-family:var(--sans);font-style:normal;}
    .bub.you{align-self:flex-end;background:var(--peach);border:1px solid var(--peach-line);border-right:4px solid var(--accent);border-radius:18px 4px 18px 18px;font-family:var(--serif);font-size:19px;color:var(--ink);}
    .bub.you .who{color:var(--accent-deep);font-family:var(--sans);}
    .ex .note{align-self:flex-end;max-width:84%;font-size:15px;line-height:1.5;color:var(--dim);padding-left:14px;border-left:2px solid var(--sage-line);}
    .ex .note b{color:var(--ink);}

    .biggest{margin-top:96px;background:var(--ink);color:#DCE5E1;padding:88px 0 96px;position:relative;overflow:hidden;}
    .biggest::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 50% 70% at 100% 0%,rgba(240,93,35,.14),transparent 60%);pointer-events:none;}
    .biggest .wide{position:relative;}
    .biggest .q{font-family:var(--serif);font-style:italic;font-size:34px;line-height:1.2;color:#fff;margin:0 0 28px;text-wrap:balance;}
    .biggest .ans{display:flex;align-items:center;gap:26px;margin:26px 0 30px;padding:24px 0;border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14);}
    .biggest .ans img{flex:none;width:104px;height:104px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,.25);}
    .biggest .ans .big{font-family:var(--serif);font-size:46px;line-height:1.06;color:#F7B08E;letter-spacing:-.01em;}
    .biggest p{font-size:17.5px;line-height:1.62;margin-bottom:16px;color:#DCE5E1;}
    .biggest p b{color:#fff;}
    .biggest .tie{margin-top:18px;}
    .biggest .wise{position:relative;font-family:var(--serif);font-size:22px;line-height:1.4;color:#fff;border-left:4px solid var(--accent);padding:6px 0 6px 20px;margin:8px 0 0;}
    #objections{padding-bottom:0;}

    /* ---------- toolkit ---------- */
    .toolkit{padding:104px 0 112px;background:var(--sage);}
    .kit-head h2{font-family:var(--serif);font-weight:600;font-size:44px;line-height:1.06;color:var(--ink);margin:10px 0 12px;letter-spacing:-.01em;}
    .kit-head p{font-size:18px;line-height:1.56;max-width:56ch;}
    .kit-index{list-style:none;display:flex;flex-wrap:wrap;gap:8px;margin-top:22px;}
    .kit-index a{display:inline-block;padding:8px 14px;border-radius:999px;background:#fff;border:1px solid var(--sage-line);font-size:14px;font-weight:600;color:var(--ink);text-decoration:none;transition:border-color .15s;}
    .kit-index a:hover{border-color:var(--ink);}
    .dl{display:flex;gap:26px;align-items:center;margin:34px 0 0;padding:22px 26px;background:var(--ink);color:#DCE5E1;text-decoration:none;transition:box-shadow .15s,transform .15s;}
    .dl:hover{box-shadow:0 14px 34px rgba(18,50,47,.25);transform:translateY(-2px);}
    .dl img{width:92px;height:auto;flex:none;box-shadow:0 6px 18px rgba(0,0,0,.35);transform:rotate(-3deg);}
    .dl .name{display:block;font-family:var(--serif);font-weight:600;font-size:25px;color:#fff;margin-bottom:4px;}
    .dl .desc{font-size:15.5px;}
    .dl .go{margin-left:auto;flex:none;font-weight:800;font-size:14px;color:#fff;background:var(--accent-deep);padding:12px 18px;border-radius:999px;}

    .tool{display:grid;grid-template-columns:260px 1fr;gap:26px 44px;margin:22px 0 0;background:#fff;border:1px solid var(--sage-line);padding:34px 36px;}
    .tool-meta h3{font-family:var(--serif);font-weight:600;font-size:28px;color:var(--ink);line-height:1.12;}
    .tool-meta .for{display:block;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-deep);margin:10px 0 18px;line-height:1.5;}
    .sheet{display:inline-flex;align-items:center;gap:8px;font-size:13.5px;font-weight:700;color:var(--ink);text-decoration:none;border:1.5px solid var(--hair);padding:8px 13px;border-radius:999px;transition:border-color .15s,background .15s;}
    .sheet:hover{border-color:var(--ink);background:var(--sage);}
    .sheet svg{width:14px;height:14px;color:var(--accent-deep);}
    .tool-wide{grid-column:1 / -1;}
    .tool-body p{font-size:17px;line-height:1.6;margin-bottom:12px;}
    .tool-body p:last-child{margin-bottom:0;}
    .tool-body p b{color:var(--ink);}

    .breath{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0 0 16px;}
    .breath > div{background:var(--paper-2);padding:18px 18px 16px;text-align:center;}
    .breath .count{display:flex;justify-content:center;gap:8px;height:22px;align-items:center;margin-bottom:10px;}
    .breath .count i{display:block;width:14px;height:14px;border-radius:50%;background:var(--accent);opacity:.85;}
    .breath b{display:block;font-family:var(--serif);font-size:20px;font-weight:600;color:var(--ink);}
    .breath span{font-size:14px;color:var(--dim);}

    .letters{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0 0 16px;}
    .letters li{display:flex;gap:14px;align-items:flex-start;background:var(--paper-2);padding:16px 16px 14px;font-size:15.5px;line-height:1.45;}
    .letters .mk{flex:none;font-family:var(--serif);font-weight:600;font-size:34px;line-height:.9;color:var(--accent-deep);width:30px;}
    .letters b{display:block;color:var(--ink);font-size:16.5px;margin-bottom:2px;}

    .ladder{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;align-items:stretch;margin:6px 0 0;}
    .rung{background:var(--paper-2);border-top:3px solid var(--ink);padding:14px 14px 16px;font-size:14.5px;line-height:1.45;color:var(--body);}
    .rung:nth-child(1){margin-top:84px;}
    .rung:nth-child(2){margin-top:56px;}
    .rung:nth-child(3){margin-top:28px;}
    .rung:nth-child(4){border-top-color:var(--accent);}
    .rung .r{display:block;font-family:var(--serif);font-size:32px;line-height:1;color:var(--accent-deep);margin-bottom:8px;}
    .rung b{display:block;font-size:15.5px;color:var(--ink);margin-bottom:6px;}
    .ladder-axis{display:flex;align-items:center;gap:12px;font-size:11.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin:12px 0 16px;}
    .ladder-axis .line{flex:1;height:2px;background:linear-gradient(90deg,var(--sage-line),var(--accent));position:relative;}
    .ladder-axis .line::after{content:"";position:absolute;right:-1px;top:-4px;border:5px solid transparent;border-left:8px solid var(--accent);border-right:0;}

    .ins{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:0 0 16px;}
    .ins li{background:var(--paper-2);padding:18px 16px 16px;font-size:15px;line-height:1.5;}
    .ins .w{font-family:var(--serif);font-size:26px;line-height:1;color:var(--ink);margin-bottom:10px;}
    .ins .w span{color:var(--accent-deep);font-weight:600;}

    .watch{margin:4px 0 0;background:var(--sage);border-left:3px solid var(--ink);padding:16px 20px;}
    .watch .wk{font-size:11.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--ink);margin-bottom:10px;}
    .watch ul{list-style:none;display:grid;gap:9px;}
    .watch li{position:relative;padding-left:20px;font-size:15.5px;line-height:1.5;}
    .watch li::before{content:"";position:absolute;left:0;top:10px;width:10px;height:2px;background:var(--accent);}
    .watch li b{color:var(--ink);}
    .watch i{font-family:var(--serif);font-size:16.5px;color:var(--ink);}

    /* ---------- start + close ---------- */
    .start{padding:112px 0;text-align:center;background:linear-gradient(180deg,var(--sage),var(--paper));}
    .start .big{font-family:var(--serif);font-weight:600;font-size:48px;line-height:1.08;color:var(--ink);margin:0 auto 18px;max-width:22ch;text-wrap:balance;letter-spacing:-.01em;}
    .start p{font-size:18px;line-height:1.55;max-width:48ch;margin:0 auto;}

    .close{background:var(--ink);color:#DCE5E1;padding:80px 0 0;}
    .close-in{display:grid;grid-template-columns:auto 1fr;gap:40px;align-items:center;}
    .close-in img{width:150px;height:150px;border-radius:50%;object-fit:cover;object-position:50% 4%;border:3px solid rgba(255,255,255,.18);}
    .close h2{font-family:var(--serif);font-weight:600;font-size:38px;color:#fff;margin-bottom:10px;}
    .close p{font-size:17.5px;line-height:1.6;max-width:52ch;}
    .close p a{color:#F7B08E;font-weight:700;}
    .close .sig{font-size:14.5px;color:#9FB3AD;margin-top:12px;}
    .foot{margin-top:72px;border-top:1px solid rgba(255,255,255,.12);padding:24px 0 28px;}
    .foot-in{display:flex;justify-content:space-between;align-items:center;font-size:14px;color:#9FB3AD;}
    .foot img{width:120px;height:auto;}
    .foot a{color:#9FB3AD;text-decoration:none;}
    .foot a:hover{color:#fff;}

    /* ---------- responsive ---------- */
    @media (max-width:1000px){
      .hero-in{grid-template-columns:1fr;gap:44px;}
      .hero h1{font-size:50px;}
      .tool{grid-template-columns:1fr;gap:20px;}
    }
    @media (max-width:700px){
      :root{--gutter:18px;}
      .pf-frame{top:12px;left:12px;right:12px;bottom:12px;}
      .pf-fg{display:none;}
      .hero.foliage .hero-in{max-width:none;padding:44px 34px 56px;}
      .bar-in{height:52px;gap:12px;}
      .bar-home{display:none;}
      .bar ol{margin-left:0;-webkit-mask-image:linear-gradient(90deg,#000 82%,transparent);mask-image:linear-gradient(90deg,#000 82%,transparent);}
      .bar li a{padding:6px 10px;font-size:13px;}
      .hero-in{padding-top:36px;padding-bottom:56px;}
      .hero .logo{width:140px;margin-bottom:36px;}
      .hero h1{font-size:40px;}
      .hero .sub-title{font-size:22px;}
      .chat-q{font-size:18px;}
      .intro{padding-top:56px;}
      .intro .big{font-size:25px;}
      .intro p.txt{font-size:17px;}
      .principle{padding:72px 0;}
      .ph .num{font-size:84px;}
      .ph h2{font-size:34px;}
      .lead{font-size:21px;}
      ul.pts li{font-size:17px;}
      .borrow-line{font-size:19px;padding:16px 18px;}
      .emails,.cards2{grid-template-columns:1fr;}
      .email .seg{grid-template-columns:1fr;gap:4px;margin-bottom:12px;}
      .move-steps{grid-template-columns:1fr;}
      .move-steps .arrow{display:none;}
      .bub,.ex .note{max-width:94%;}
      .bub.they,.bub.you{font-size:18px;}
      .biggest{margin-top:72px;padding:64px 0 72px;}
      .biggest .q{font-size:27px;}
      .biggest .ans .big{font-size:36px;}
      .toolkit{padding:72px 0 80px;}
      .kit-head h2{font-size:34px;}
      .dl{flex-direction:column;align-items:flex-start;}
      .dl .go{margin-left:0;}
      .tool{padding:26px 20px;}
      .letters,.ins,.breath{grid-template-columns:1fr;}
      .ladder{grid-template-columns:1fr;}
      .rung{margin-top:0 !important;}
      .ladder-axis{display:none;}
      .start{padding:80px 0;}
      .start .big{font-size:36px;}
      .close-in{grid-template-columns:1fr;gap:24px;}
      .close-in img{width:112px;height:112px;}
      .close h2{font-size:30px;}
      .foot-in{flex-direction:column;gap:14px;align-items:flex-start;}
    }

    @media print{
      .bar,.contents-tools,.kit-index,.chat-bar .dot{display:none !important;}
      body{background:#fff;}
      .hero,.biggest,.close,.toolkit,.principle.alt,.start{background:#fff !important;color:var(--body) !important;}
      .hero::before,.biggest::before{display:none;}
      .pf-bg,.pf-frame,.pf-fg{display:none;}
      .hero h1,.biggest .q,.close h2{color:var(--ink) !important;}
      .hero .sub-title,.hero .from,.hero .from a,.biggest p,.biggest p b,.close p,.close p a,.close .sig,.foot-in,.foot a{color:var(--body) !important;}
      .email .ebar,.email .st,.email .lt,.mv{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
      .dl .go{display:none;}
      .chat{box-shadow:none;border:1px solid var(--hair);}
      ul.pts li::before,.watch li::before{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
      .ph,.kit-head h2,.tool-meta{break-after:avoid;}
      .ph h2,.lead{break-inside:avoid;}
      .biggest .ans .big,.biggest .wise{color:var(--ink) !important;}
      .biggest{border:2px solid var(--ink);}
      .msg{animation:none;opacity:1;transform:none;}
      .principle,.toolkit,.start{padding:40px 0;}
      .tool,.card,.ex,.borrow-line,.biggest,.cards5,.ladder{break-inside:avoid;}
      .dl{background:#fff;color:var(--body);border:1px solid var(--hair);}
      .dl .name{color:var(--ink);}
    }
  
    .backlink{display:none;margin:-18px 0 30px;}
    .backlink a{color:#C9D8D3;font-size:14px;font-weight:600;text-decoration:none;}
    .backlink a:hover{color:#fff;}
  </style>
</head>
<body>
  <nav class="bar" id="bar" aria-label="Chapters">
    <div class="bar-in">
      <a class="bar-home" href="#top" aria-label="Back to top"><img src="/images/lotus.png" alt="" width="24" height="24" /></a>
      <ol>
        {chapters.map((c) => (
          <li><a href={`#${c.id}`} data-ch={c.id}><span class="n">{c.n}</span>{c.short}</a></li>
        ))}
      </ol>
    </div>
    <div class="prog" id="prog"></div>
  </nav>

  <slot />

  <script is:inline>
    (function(){
      // Sticky chapter bar: show after the hero, highlight the current chapter, track progress
      var bar=document.getElementById('bar'),prog=document.getElementById('prog'),hero=document.getElementById('top');
      var links=[].slice.call(bar.querySelectorAll('a[data-ch]'));
      var secs=links.map(function(a){return document.getElementById(a.dataset.ch);});
      var current=null;
      var ticking=false;
      function update(){
        ticking=false;
        var y=window.scrollY,h=document.documentElement.scrollHeight-window.innerHeight,heroH=hero?hero.offsetHeight:0,vh=window.innerHeight;
        var active=null;
        secs.forEach(function(s,i){if(s&&s.getBoundingClientRect().top<vh*0.35)active=i;});
        bar.classList.toggle('on',y>heroH-60);
        if(active!==current){
          links.forEach(function(a,i){a.classList.toggle('active',i===active);});
          if(active!==null){var a=links[active],ol=a.closest('ol');ol.scrollTo({left:a.offsetLeft-ol.clientWidth/2+a.offsetWidth/2,behavior:'smooth'});}
          current=active;
        }
        prog.style.transform='scaleX('+(h>0?Math.min(1,y/h):0)+')';
      }
      function onScroll(){if(!ticking){ticking=true;requestAnimationFrame(update);}}
      window.addEventListener('scroll',onScroll,{passive:true});
      window.addEventListener('resize',onScroll);
      update();
    })();
  </script>
  <script define:vars={{ clientLookup }}>
    // ?client=<slug> (links from a firm's resources page) adds a back link inside the hero.
    var slug = new URLSearchParams(location.search).get('client');
    var el = document.getElementById('backlink');
    if (el && slug && Object.prototype.hasOwnProperty.call(clientLookup, slug)) {
      var a = el.querySelector('a');
      a.href = '/' + slug;
      a.textContent = '\u2190 Back to ' + clientLookup[slug] + ' resources';
      el.style.display = 'block';
    }
  </script>
</body>
</html>
